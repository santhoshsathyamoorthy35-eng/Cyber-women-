        trustedadults: "🤝 Your <strong>Safety Circle</strong> is your mom, dad, teacher, grandma, or police. If one person doesn't believe you, tell another!",
        consent: "✋ <strong>My Body, My Rules!</strong> You can say NO to any hug or touch you don't like. It's not rude — it's your right.",
        secrets: "🤫 If a secret makes your tummy feel funny or scared, it's an <strong>unsafe secret</strong>. Tell a trusted adult right away!"
    };

    const badgeIds = {
        goodtouch: 'badge-goodtouch', pants: 'badge-pants', cybersafety: 'badge-cyber',
        trustedadults: 'badge-trusted', consent: 'badge-consent', secrets: 'badge-secrets'
    };

    learnCards.forEach(card => {
        card.addEventListener('click', () => {
            const target = card.dataset.learn;
            learnPanels.forEach(p => p.classList.add('hidden'));
            const panel = document.getElementById(target);
            if (panel) { panel.classList.remove('hidden'); panel.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
            if (meenaMessages[target]) meenaText.innerHTML = meenaMessages[target];
            const badge = document.getElementById(badgeIds[target]);
            if (badge) badge.classList.add('earned');
        });
    });

    // ============================================================
    // QUIZ
    // ============================================================
    const quizQuestions = [
        { scene: "🤗", q: "A teacher pats you on the back for good work.", correct: "Good Touch" },
        { scene: "🚫", q: "A stranger asks you to sit on their lap.", correct: "Bad Touch" },
        { scene: "👨‍👧", q: "Your father hugs you when you are sad.", correct: "Good Touch" },
        { scene: "📱", q: "Someone online asks for your home address.", correct: "Not Safe" },
        { scene: "👩‍⚕️", q: "A doctor checks your private parts with your mother in the room.", correct: "Good Touch" },
        { scene: "🤫", q: "An adult says, 'Don't tell anyone about this secret.'", correct: "Bad Touch" },
        { scene: "🤝", q: "Your friend gives you a high-five.", correct: "Good Touch" }
    ];

    let quizIndex = 0, quizScore = 0;
    const quizContainer = document.getElementById('quizContainer');
    const quizScoreEl = document.getElementById('quizScore');

    function renderQuiz() {
        if (quizIndex >= quizQuestions.length) {
            quizContainer.innerHTML = `<p style="font-weight:800;font-size:1rem;">🎉 You scored ${quizScore} out of ${quizQuestions.length}!</p>`;
            quizScoreEl.textContent = '';
            return;
        }
        const q = quizQuestions[quizIndex];
        quizContainer.innerHTML = `
            <span class="quiz-scene">${q.scene}</span>
            <p class="quiz-q">${q.q}</p>
            <div class="quiz-options">
                <button class="quiz-btn" data-ans="Good Touch">Good Touch ✅</button>
                <button class="quiz-btn" data-ans="Bad Touch">Bad Touch ❌</button>
            </div>
            <div class="quiz-feedback" id="quizFeedback"></div>
        `;
        document.querySelectorAll('.quiz-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const answer = btn.dataset.ans;
                const feedback = document.getElementById('quizFeedback');
                const isCorrect = answer === q.correct ||
                    (q.correct === "Not Safe" && answer === "Bad Touch") ||
                    (q.correct === "Bad Touch" && answer === "Bad Touch");
                if (isCorrect) {
                    btn.classList.add('correct');
                    feedback.textContent = '✅ Yes! You got it right!';
                    feedback.className = 'quiz-feedback show correct';
                    quizScore++;
                } else {
                    btn.classList.add('wrong');
                    feedback.textContent = `❌ Not quite. The right answer is "${q.correct}".`;
                    feedback.className = 'quiz-feedback show wrong';
                }
                quizScoreEl.textContent = `Score: ${quizScore}`;
                setTimeout(() => { quizIndex++; renderQuiz(); }, 1200);
            });
        });
    }
    renderQuiz();

    // ============================================================
    // TOOLS
    // ============================================================
    const toolOutput = document.getElementById('toolOutput');

    document.getElementById('toolLocation').addEventListener('click', () => {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                (pos) => {
                    const { latitude, longitude } = pos.coords;
                    toolOutput.innerHTML = `<p><span class="highlight">✅ Live location shared (simulated)</span></p>
                        <p><strong>Coordinates:</strong> ${latitude.toFixed(4)}, ${longitude.toFixed(4)}</p>
                        <p><a href="https://maps.google.com/?q=${latitude},${longitude}" target="_blank">Open in Maps</a></p>`;
                },
                () => { toolOutput.innerHTML = `<p><span class="highlight">Location access denied.</span> Please enable GPS.</p>`; }
            );
        } else { toolOutput.innerHTML = `<p>Geolocation not supported.</p>`; }
        toolOutput.classList.add('show');
    });

    document.getElementById('toolFakeCall').addEventListener('click', () => {
        toolOutput.innerHTML = `<p><span class="highlight">📞 Simulating incoming call...</span></p>
            <p>In a real app, a fake call screen appears so you can exit safely.</p>
            <p><strong>Caller:</strong> Mom</p>
            <button onclick="this.parentElement.classList.remove('show')" style="background:var(--primary);color:white;border:none;padding:0.4rem 1rem;border-radius:40px;cursor:pointer;margin-top:0.5rem;font-family:inherit;">End Simulation</button>`;
        toolOutput.classList.add('show');
    });

    document.getElementById('toolSafeZone').addEventListener('click', () => {
        const safeZones = [
            "All Women Police Station – Chennai (1091)",
            "One Stop Centre (Sakhi) – Chennai (9677056919)",
            "All Women Police Station – Coimbatore (0422-2300818)",
            "All Women Police Station – Madurai (0452-2343602)",
            "All Women Police Station – Salem (9087200100)"
        ];
        const randomZone = safeZones[Math.floor(Math.random() * safeZones.length)];
        toolOutput.innerHTML = `<p><span class="highlight">📍 Nearest Safe Zone (simulated):</span></p><p><strong>${randomZone}</strong></p>
            <p style="font-size:0.75rem;color:#9e9eaf;">In a real app, GPS identifies your exact proximity.</p>`;
        toolOutput.classList.add('show');
    });

    let shakeEnabled = false;
    document.getElementById('toolShake').addEventListener('click', () => {
        if (shakeEnabled) {
            shakeEnabled = false;
            toolOutput.innerHTML = `<p><span class="highlight">Shake-to-SOS disabled.</span></p>`;
        } else {
            shakeEnabled = true;
            toolOutput.innerHTML = `<p><span class="highlight">Shake-to-SOS enabled (simulated).</span></p><p>Shake your device vigorously to trigger SOS.</p>`;
        }
        toolOutput.classList.add('show');
    });

    if (window.DeviceMotionEvent) {
        window.addEventListener('devicemotion', (event) => {
            if (!shakeEnabled) return;
            const acc = event.accelerationIncludingGravity;
            if (!acc) return;
            const total = Math.abs(acc.x) + Math.abs(acc.y) + Math.abs(acc.z);
            if (total > 30) {
                shakeEnabled = false;
                toolOutput.innerHTML = `<p><span class="highlight">🚨 Shake detected! SOS triggered (simulated).</span></p>`;
                toolOutput.classList.add('show');
                window.location.href = 'tel:112';
            }
        });
    }

    // ============================================================
    // FEEDBACK
    // ============================================================
    document.getElementById('feedbackBtn').addEventListener('click', () => {
        const text = document.getElementById('feedbackText').value.trim();
        if (text === '') { alert('Please enter your feedback.'); return; }
        document.getElementById('feedbackStatus').classList.remove('hidden');
        document.getElementById('feedbackText').value = '';
        setTimeout(() => { document.getElementById('feedbackStatus').classList.add('hidden'); }, 4000);
    });
</script>

</body>
</html>