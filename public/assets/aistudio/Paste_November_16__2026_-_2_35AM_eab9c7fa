    // ============================================================
    // RENDER FUNCTIONS
    // ============================================================
    let currentCategory = 'all';

    function renderHelplines(filter = '', category = 'all') {
        const grid = document.getElementById('helplinesGrid');
        const term = filter.toLowerCase();
        let filtered = helplines.filter(h =>
            h.name.toLowerCase().includes(term) || h.number.toLowerCase().includes(term) ||
            h.desc.toLowerCase().includes(term) || h.category.toLowerCase().includes(term)
        );
        if (category !== 'all') filtered = filtered.filter(h => h.category === category);
        if (filtered.length === 0) {
            grid.innerHTML = `<p style="grid-column:1/-1;text-align:center;color:#b0b0c0;padding:2rem;">No helplines found. Try a different search.</p>`;
            return;
        }
        grid.innerHTML = filtered.map(h => `
            <div class="info-card">
                <div class="card-header">
                    <div class="card-icon"><i class="fas ${h.icon}"></i></div>
                    <div><h3>${h.name}</h3><span class="card-tag">${h.category}</span></div>
                </div>
                <div class="card-detail">${h.desc}</div>
                <a href="tel:${h.number.replace(/[^0-9+]/g, '')}" class="card-number"><i class="fas fa-phone-alt" style="font-size:0.7rem;"></i> ${h.number}</a>
            </div>
        `).join('');
    }

    function renderOrganizations(filter = '') {
        const grid = document.getElementById('orgsGrid');
        const term = filter.toLowerCase();
        const filtered = organizations.filter(o =>
            o.name.toLowerCase().includes(term) || o.desc.toLowerCase().includes(term) ||
            o.location.toLowerCase().includes(term) || o.type.toLowerCase().includes(term)
        );
        if (filtered.length === 0) {
            grid.innerHTML = `<p style="grid-column:1/-1;text-align:center;color:#b0b0c0;padding:2rem;">No organizations found.</p>`;
            return;
        }
        grid.innerHTML = filtered.map(o => `
            <div class="info-card">
                <div class="card-header">
                    <div class="card-icon"><i class="fas fa-building"></i></div>
                    <div><h3>${o.name} <span class="${o.badge === 'Gov' ? 'badge-gov' : 'badge-ngo'}">${o.badge === 'Gov' ? 'Gov' : 'NGO'}</span></h3><span class="card-tag">${o.location}</span></div>
                </div>
                <div class="card-detail">${o.desc}</div>
            </div>
        `).join('');
    }

    renderHelplines();
    renderOrganizations();

    // ============================================================
    // TABS
    // ============================================================
    const navTabs = document.querySelectorAll('.nav-tab');
    const sections = document.querySelectorAll('.section');
    navTabs.forEach(tab => {
        tab.addEventListener('click', () => {
            navTabs.forEach(t => t.classList.remove('active'));
            tab.classList.add('active');
            const target = tab.dataset.section;
            sections.forEach(sec => sec.classList.toggle('active', sec.id === target));
            document.getElementById('searchInput').value = '';
            document.getElementById('categoryFilter').value = 'all';
            currentCategory = 'all';
            renderHelplines();
            renderOrganizations();
        });
    });

    // ============================================================
    // SEARCH
    // ============================================================
    document.getElementById('searchInput').addEventListener('input', (e) => {
        const term = e.target.value.trim();
        const activeSection = document.querySelector('.section.active').id;
        if (activeSection === 'helplines') renderHelplines(term, currentCategory);
        else if (activeSection === 'organizations') renderOrganizations(term);
    });
    document.getElementById('categoryFilter').addEventListener('change', (e) => {
        currentCategory = e.target.value;
        const term = document.getElementById('searchInput').value.trim();
        renderHelplines(term, currentCategory);
    });

