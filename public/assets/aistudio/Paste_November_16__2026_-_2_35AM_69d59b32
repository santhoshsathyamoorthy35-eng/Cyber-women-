     Netlify hosting facts for this site: static/SSR served via Netlify Edge. -->
<title>CRIMEMAP 3D — Puducherry Police Command | Santhosh</title>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<link href="https://unpkg.com/maplibre-gl@3.6.2/dist/maplibre-gl.css" rel="stylesheet"/>
<script src="https://unpkg.com/maplibre-gl@3.6.2/dist/maplibre-gl.js"></script>
<style>
:root{
  --bg:#06090f; --panel:#0b1220; --panel2:#111b30; --panel3:#16223c;
  --line:#1c2a44; --line2:#243355;
  --fg:#eaf0fb; --muted:#7e91b8; --muted2:#5f7096;
  --accent:#ff3b5c; --accent2:#3ba3ff; --gold:#ffcc4d; --ok:#26c281;
  --purple:#a06bff; --orange:#ff7a3c;
}
*{box-sizing:border-box;-webkit-font-smoothing:antialiased}
html,body{margin:0;height:100%;font-family:Inter,-apple-system,system-ui,"Segoe UI",Roboto,sans-serif;
          background:var(--bg);color:var(--fg);overflow:hidden;font-size:14px}
button{font-family:inherit}
input,select,textarea{font-family:inherit}

/* LOADER */
#loader{position:fixed;inset:0;background:radial-gradient(ellipse at center,#0b1220,#06090f);
        z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;
        gap:22px;transition:opacity .6s}
#loader.hide{opacity:0;pointer-events:none}
.spin{width:60px;height:60px;border:3px solid var(--line);border-top-color:var(--accent);
      border-radius:50%;animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.lTitle{font-size:22px;font-weight:900;letter-spacing:3px}
.lTitle span{color:var(--accent)}
.lText{color:var(--muted);font-size:12.5px;letter-spacing:1.5px;text-transform:uppercase}
.lBar{width:280px;height:3px;background:var(--line);border-radius:3px;overflow:hidden}
.lBar > div{height:100%;width:0%;background:linear-gradient(90deg,var(--accent),var(--gold));
            transition:width .35s}

/* APP SHELL */
#app{display:grid;grid-template-rows:60px 46px 1fr 28px;height:100vh}

/* HEADER */
header{display:flex;align-items:center;justify-content:space-between;
       padding:0 20px;background:linear-gradient(90deg,#06090f,#0f1a30 50%,#1a0a18);
       border-bottom:1px solid var(--line);position:relative;z-index:20}
header::after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:1px;
              background:linear-gradient(90deg,var(--accent),var(--accent2),var(--gold),transparent)}
.brand{display:flex;align-items:center;gap:14px}
.logo{width:38px;height:38px;border-radius:10px;
      background:linear-gradient(135deg,var(--accent),#7a0016);
      display:grid;place-items:center;font-weight:900;color:#fff;font-size:19px;
      box-shadow:0 0 20px rgba(255,59,92,.45)}
.title{font-weight:800;letter-spacing:.5px;font-size:15.5px;line-height:1.1}
.title span{color:var(--accent)}
.subtitle{font-size:10.5px;color:var(--muted);margin-top:2px;letter-spacing:.4px}
.subtitle b{color:var(--gold);font-weight:700}
.headerRight{display:flex;align-items:center;gap:12px}
.search{position:relative}
.search input{background:#0b1730;border:1px solid var(--line);color:var(--fg);
              border-radius:8px;padding:7px 12px 7px 34px;font-size:12.5px;width:220px;
              transition:border-color .15s,width .2s}
.search input:focus{outline:none;border-color:var(--accent2);width:260px}
.search::before{content:"🔍";position:absolute;left:10px;top:50%;transform:translateY(-50%);
                font-size:12px;opacity:.6}
.bell{position:relative;background:#0b1730;border:1px solid var(--line);border-radius:8px;
      padding:7px 10px;cursor:pointer;font-size:14px;color:var(--fg)}
.bell:hover{border-color:var(--accent2)}
.bell .dot{position:absolute;top:-4px;right:-4px;background:var(--accent);color:#fff;
           border-radius:99px;font-size:9px;font-weight:700;padding:1px 5px;
           border:2px solid var(--bg)}
.clock{font-size:11.5px;color:var(--muted);text-align:right;line-height:1.4;
       font-variant-numeric:tabular-nums;letter-spacing:.3px}

/* TABS */
nav.tabs{display:flex;gap:2px;padding:0 20px;background:var(--panel);
         border-bottom:1px solid var(--line);align-items:flex-end;overflow-x:auto}
nav.tabs button{background:none;border:none;color:var(--muted);padding:10px 16px 12px;
                font-size:12.5px;font-weight:600;cursor:pointer;letter-spacing:.4px;
                border-bottom:2px solid transparent;transition:color .15s,border-color .15s;
                display:flex;align-items:center;gap:7px;white-space:nowrap}
nav.tabs button:hover{color:var(--fg)}
nav.tabs button.active{color:var(--accent);border-bottom-color:var(--accent)}
nav.tabs button.live.active{color:#ff5c78;border-bottom-color:#ff5c78}
nav.tabs .key{font-size:9px;padding:1px 5px;border-radius:4px;background:#0b1730;
              border:1px solid var(--line);color:var(--muted2);font-weight:700}
nav.tabs .liveDot{width:7px;height:7px;border-radius:50%;background:var(--accent);
                  box-shadow:0 0 8px var(--accent);animation:pulse 1.4s infinite}

/* MAIN GRID */
main{display:grid;grid-template-columns:300px 1fr 340px;height:100%;overflow:hidden;
     position:relative}
.leftPanel,.rightPanel{overflow-y:auto;background:var(--panel);
                       border-right:1px solid var(--line);padding-bottom:20px}
.rightPanel{border-right:none;border-left:1px solid var(--line)}
.leftPanel::-webkit-scrollbar,.rightPanel::-webkit-scrollbar{width:6px}
.leftPanel::-webkit-scrollbar-thumb,.rightPanel::-webkit-scrollbar-thumb{
  background:#243355;border-radius:3px}
.leftPanel::-webkit-scrollbar-track,.rightPanel::-webkit-scrollbar-track{background:transparent}

.panelSet{display:none}
.panelSet.active{display:block}

/* CARDS */
.card{background:var(--panel2);margin:12px;border-radius:12px;padding:14px;
      border:1px solid var(--line);box-shadow:0 2px 10px rgba(0,0,0,.25)}
.card h3{margin:0 0 12px;font-size:10.5px;letter-spacing:1.2px;color:var(--muted);
         text-transform:uppercase;font-weight:700;display:flex;align-items:center;gap:8px}
.card h3::before{content:"";width:3px;height:12px;background:var(--accent);border-radius:2px}
.card h3 .right{margin-left:auto;font-size:9px;color:var(--muted2);font-weight:600}

/* STAT */
.stat{display:flex;justify-content:space-between;align-items:center;padding:8px 0;
      border-bottom:1px dashed var(--line);font-size:13px}
.stat:last-child{border:none;padding-bottom:0}
.stat span{color:var(--muted)}
.stat b{color:var(--fg);font-variant-numeric:tabular-nums;font-size:14px}
.stat b.gold{color:var(--gold)}
.stat b.accent{color:var(--accent)}
.stat b.ok{color:var(--ok)}

/* KPI CARD */
.kpi{padding:12px;border-radius:10px;background:linear-gradient(135deg,var(--panel3),var(--panel2));
     border:1px solid var(--line);margin-bottom:8px}
.kpi .label{font-size:10px;letter-spacing:1px;color:var(--muted);text-transform:uppercase;
            font-weight:600;margin-bottom:4px}
.kpi .value{font-size:26px;font-weight:800;font-variant-numeric:tabular-nums;
            letter-spacing:-.5px;line-height:1}
.kpi .delta{font-size:11px;color:var(--ok);margin-top:4px;font-weight:600}
.kpi .delta.down{color:var(--accent)}
.kpi.red .value{color:var(--accent)}
.kpi.gold .value{color:var(--gold)}
.kpi.blue .value{color:var(--accent2)}
.kpi.green .value{color:var(--ok)}
.kpi.purple .value{color:var(--purple)}

/* INPUTS */
label.lbl{font-size:11px;color:var(--muted);display:block;margin:10px 0 5px;
          letter-spacing:.4px;font-weight:500}
select,input[type="text"],input[type="number"],textarea{
  width:100%;background:#080f1e;color:var(--fg);border:1px solid var(--line);
  border-radius:8px;padding:8px 10px;font-size:12.5px;transition:border-color .15s}
select:focus,input:focus,textarea:focus{outline:none;border-color:var(--accent2)}
textarea{resize:vertical;min-height:52px}
input[type="range"]{width:100%;accent-color:var(--accent);cursor:pointer}

/* BUTTONS */
button.act{cursor:pointer;background:linear-gradient(135deg,var(--accent),#a3081f);
           border:none;font-weight:700;letter-spacing:.3px;color:#fff;
           padding:10px 14px;border-radius:8px;font-size:12.5px;
           transition:transform .1s,filter .15s;width:100%}
button.act:hover{filter:brightness(1.15)}
button.act:active{transform:scale(.98)}
button.act.sec{background:linear-gradient(135deg,var(--accent2),#1a4b8a)}
button.act.ok{background:linear-gradient(135deg,var(--ok),#0d7a4d)}
button.act.ghost{background:transparent;border:1px solid var(--line);color:var(--fg)}
button.act.ghost:hover{border-color:var(--accent2);color:var(--accent2);filter:none}
button.act.sm{padding:7px 10px;font-size:11.5px}
.row{display:flex;gap:8px;margin-top:10px}
.row > *{flex:1}

/* TOGGLE */
.toggle{display:flex;align-items:center;gap:9px;padding:7px 0;font-size:12.5px;cursor:pointer;
        user-select:none;transition:color .15s}
.toggle:hover{color:var(--accent2)}
.toggle input{width:auto;accent-color:var(--accent);cursor:pointer;margin:0}

/* MAP */
.mapWrap{position:relative;overflow:hidden;background:#02040a;perspective:1400px}
#map{width:100%;height:100%;filter:saturate(1.18) contrast(1.07) brightness(1.04)}
.mapOverlayTop{position:absolute;left:14px;top:14px;z-index:5;
  background:rgba(6,9,15,.85);backdrop-filter:blur(10px);
  border:1px solid var(--line);border-radius:10px;padding:8px 12px;
  font-size:11.5px;display:flex;gap:8px;flex-wrap:wrap;max-width:75%}
.mapOverlayBottom{position:absolute;right:14px;bottom:14px;z-index:5;
  background:rgba(6,9,15,.85);backdrop-filter:blur(10px);
  border:1px solid var(--line);border-radius:10px;padding:10px 14px;font-size:11px}
.pill{display:inline-flex;align-items:center;gap:5px;font-size:10.5px;padding:3px 9px;
      border-radius:99px;background:#0a1424;color:var(--muted);
      border:1px solid var(--line);font-variant-numeric:tabular-nums;font-weight:600}
.pill.on{color:var(--gold);border-color:#3a2c10;background:#1a1508}
.pill.live::before{content:"";width:6px;height:6px;border-radius:50%;
                   background:var(--ok);box-shadow:0 0 6px var(--ok);
                   animation:pulse 1.6s infinite}
.pill.red{color:#ff8ba0;border-color:#3a0c16;background:#1a0810}
.pill.blue{color:var(--accent2);border-color:#0f2f52;background:#08172b}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
.legend{display:flex;align-items:center;gap:8px;margin:3px 0;font-size:11px}
.legend .sw{width:14px;height:10px;border-radius:3px;flex-shrink:0}

/* LIST ITEMS */
.hot{display:flex;justify-content:space-between;align-items:center;
     padding:9px 11px;margin:6px 0;background:#080f1e;border-radius:9px;
     border-left:3px solid var(--accent);font-size:12px;cursor:pointer;
     transition:background .15s,transform .1s}
.hot:hover{background:#0f1a30;transform:translateX(2px)}
.hot .l{flex:1;min-width:0}
.hot .l b{display:block;font-size:12.5px;margin-bottom:3px;color:var(--fg)}
.hot .l .meta{color:var(--muted);font-size:10.5px}
.hot .r{color:var(--gold);font-weight:800;font-size:17px;
        font-variant-numeric:tabular-nums;letter-spacing:-.5px}

.badge{font-size:9.5px;padding:2px 7px;border-radius:99px;
       background:#0a1424;border:1px solid var(--line);color:var(--muted);
       display:inline-block;margin-right:3px;margin-top:3px;font-weight:600}
.badge.ok{color:var(--ok);border-color:#0c3a24;background:#081a10}
.badge.warn{color:var(--gold);border-color:#3a2c10;background:#1a1508}
.badge.red{color:var(--accent);border-color:#3a0c16;background:#1a0810}
.badge.blue{color:var(--accent2);border-color:#0f2f52;background:#08172b}

.alert{background:linear-gradient(90deg,#2a0f18,#180a10);
       border-left:3px solid var(--accent);padding:10px 12px;
       border-radius:8px;margin:7px 0;font-size:11.5px;line-height:1.45;
       cursor:pointer;transition:transform .1s}
.alert:hover{transform:translateX(2px)}
.alert b{color:#ff8ba0}
.alert .mut{color:var(--muted);font-size:10.5px}
.alert.gold{background:linear-gradient(90deg,#1f1a08,#12100a);border-left-color:var(--gold)}
.alert.gold b{color:var(--gold)}

/* DETECTION CARDS */
.detCard{background:linear-gradient(90deg,#22080f,#0f0a12);
         border-left:3px solid var(--accent);border-radius:9px;
         padding:10px 12px;margin:7px 0;font-size:11.5px;line-height:1.5;
         cursor:pointer;transition:transform .12s,background .12s;position:relative}
.detCard:hover{transform:translateX(2px);background:linear-gradient(90deg,#2c0b14,#140c17)}
.detCard.dispatched{border-left-color:var(--ok);background:linear-gradient(90deg,#082016,#0a1410)}
.detCard.ack{border-left-color:var(--accent2);background:linear-gradient(90deg,#08192b,#0a111c);opacity:.78}
.detCard .ttl{font-weight:800;color:#ff8ba0;font-size:12.5px;display:flex;
              align-items:center;gap:6px;margin-bottom:3px}
.detCard.dispatched .ttl{color:#63e0a8}
.detCard.ack .ttl{color:#7cc4ff}
.detCard .meta{color:var(--muted);font-size:10.5px}
.detCard .acts{display:flex;gap:6px;margin-top:8px}
.detCard .acts button{flex:1;font-size:10px;padding:5px 6px;border-radius:6px;
  border:1px solid var(--line);background:#0a1424;color:var(--fg);cursor:pointer;
  font-weight:700;letter-spacing:.3px}
.detCard .acts button:hover{border-color:var(--accent2);color:var(--accent2)}
.detCard .acts button.go{border-color:#0c3a24;background:#081a10;color:var(--ok)}
.detCard .acts button.go:hover{border-color:var(--ok)}
.confBar{height:4px;background:#0a1424;border-radius:3px;overflow:hidden;margin-top:6px}
.confBar > div{height:100%;background:linear-gradient(90deg,var(--accent),var(--gold))}

/* REPORT LIST */
.report{padding:9px 0;border-bottom:1px dashed var(--line);font-size:11.5px;cursor:pointer}
.report:last-child{border:none}
.report:hover{color:var(--accent2)}
.report b{color:var(--fg);display:block;margin-bottom:3px}
.report .desc{color:var(--muted);display:block;margin-bottom:4px;line-height:1.4}
.report .badges{margin-top:4px}

/* TABLE */
.tbl{width:100%;border-collapse:collapse;font-size:11.5px}
.tbl th{text-align:left;padding:8px 6px;border-bottom:1px solid var(--line);
        color:var(--muted);font-size:10px;letter-spacing:.8px;text-transform:uppercase;
        font-weight:700}
.tbl td{padding:8px 6px;border-bottom:1px dashed var(--line);
        font-variant-numeric:tabular-nums}
.tbl tr:hover td{background:#0f1a30}
.tbl tr:last-child td{border:none}

/* CHARTS */
.chartBox{background:#080f1e;border-radius:9px;padding:10px;
          border:1px solid var(--line);margin-bottom:10px}
.chartBox h4{margin:0 0 8px;font-size:10px;color:var(--muted);
             letter-spacing:.9px;text-transform:uppercase;font-weight:700}

/* NOTIFICATIONS DRAWER */
.notifDrawer{position:absolute;top:60px;right:16px;width:340px;max-height:70vh;
             background:var(--panel2);border:1px solid var(--line2);border-radius:12px;
             box-shadow:0 12px 40px rgba(0,0,0,.6);z-index:50;overflow:hidden;
             transform-origin:top right;transform:scale(.95);opacity:0;
             pointer-events:none;transition:all .18s}
.notifDrawer.show{transform:scale(1);opacity:1;pointer-events:auto}
.notifDrawer h4{margin:0;padding:12px 14px;background:var(--panel3);
                border-bottom:1px solid var(--line);font-size:11.5px;
                letter-spacing:1px;text-transform:uppercase;color:var(--muted);
                display:flex;justify-content:space-between;align-items:center}
.notifList{max-height:calc(70vh - 44px);overflow-y:auto;padding:8px}
.notif{padding:10px 12px;margin-bottom:6px;background:#080f1e;border-radius:8px;
       border-left:3px solid var(--accent2);font-size:11.5px;line-height:1.4}
.notif.red{border-left-color:var(--accent)}
.notif.gold{border-left-color:var(--gold)}
.notif.green{border-left-color:var(--ok)}
.notif .t{color:var(--muted2);font-size:10px;margin-top:4px}

/* TOAST */
#toast{position:fixed;bottom:44px;left:50%;transform:translateX(-50%) translateY(20px);
       background:var(--panel2);border:1px solid var(--ok);color:var(--fg);
       padding:12px 22px;border-radius:10px;font-size:13px;opacity:0;
       transition:opacity .3s,transform .3s;z-index:999;pointer-events:none;
       box-shadow:0 10px 40px rgba(0,0,0,.6);max-width:80vw;text-align:center;
       font-weight:500}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#toast.err{border-color:var(--accent)}
#toast.warn{border-color:var(--gold)}

/* FOOTER */
footer{padding:6px 20px;font-size:10.5px;color:var(--muted);
       border-top:1px solid var(--line);background:#06090f;
       display:flex;justify-content:space-between;align-items:center;
       font-variant-numeric:tabular-nums}
footer .status{display:flex;gap:14px;align-items:center}
footer .status b{color:var(--ok)}
footer .credits b{color:var(--gold)}

/* ==================================================================
   CINEMATIC HUD (kept — professional look, no cinema button)
   ================================================================== */
.vignette{position:absolute;inset:0;pointer-events:none;z-index:3;
  background:
    radial-gradient(ellipse 78% 68% at 50% 50%, rgba(0,0,0,0) 38%, rgba(0,0,0,.66) 100%),
    repeating-linear-gradient(0deg, rgba(140,200,255,.030) 0 1px, rgba(0,0,0,0) 1px 3px)}
.vignette::after{content:"";position:absolute;inset:0;
  background:linear-gradient(90deg, rgba(255,59,92,.055), rgba(0,0,0,0) 22%,
             rgba(0,0,0,0) 78%, rgba(59,163,255,.065))}

.letterbox{position:absolute;left:0;right:0;height:0;background:#000;z-index:9;
  pointer-events:none;transition:height .9s cubic-bezier(.5,0,.2,1)}
.letterbox.top{top:0;border-bottom:1px solid rgba(255,255,255,.07)}
.letterbox.bottom{bottom:0;border-top:1px solid rgba(255,255,255,.07)}
.cinema .letterbox{height:11%}

.hudCorners{position:absolute;inset:8px;z-index:6;pointer-events:none;opacity:.55}
.hudCorners .c{position:absolute;width:26px;height:26px;border:2px solid var(--accent2)}
.hudCorners .tl{top:0;left:0;border-right:0;border-bottom:0}
.hudCorners .tr{top:0;right:0;border-left:0;border-bottom:0}
.hudCorners .bl{bottom:0;left:0;border-right:0;border-top:0}
.hudCorners .br{bottom:0;right:0;border-left:0;border-top:0}

.scanline{position:absolute;left:0;right:0;height:130px;z-index:4;pointer-events:none;
  opacity:.5;
  background:linear-gradient(180deg, rgba(59,163,255,0), rgba(59,163,255,.09) 62%,
             rgba(59,163,255,.30) 100%);
  border-bottom:1px solid rgba(59,163,255,.55);
  animation:scan 7.5s linear infinite}
@keyframes scan{0%{top:-130px}100%{top:100%}}

.reticle{position:absolute;left:50%;top:50%;width:150px;height:150px;
  margin:-75px 0 0 -75px;z-index:8;pointer-events:none;opacity:0;
  transform:scale(1.55) rotate(-9deg);
  transition:opacity .35s, transform .55s cubic-bezier(.2,.8,.2,1)}
.reticle.show{opacity:1;transform:scale(1) rotate(0)}
.reticle .ring{position:absolute;inset:0;border:1px solid rgba(255,59,92,.55);
  border-radius:50%;animation:spinSlow 9s linear infinite}
.reticle .ring::before{content:"";position:absolute;inset:15px;border-radius:50%;
  border:1px dashed rgba(255,59,92,.35)}
.reticle .dot{position:absolute;left:50%;top:50%;width:6px;height:6px;
  margin:-3px 0 0 -3px;background:var(--accent);border-radius:50%;
  box-shadow:0 0 16px var(--accent)}
.reticle .cn{position:absolute;width:22px;height:22px;border:2px solid var(--accent)}
.reticle .cn.tl{top:0;left:0;border-right:0;border-bottom:0}
.reticle .cn.tr{top:0;right:0;border-left:0;border-bottom:0}
.reticle .cn.bl{bottom:0;left:0;border-right:0;border-top:0}
.reticle .cn.br{bottom:0;right:0;border-left:0;border-top:0}
.reticleLabel{position:absolute;left:50%;top:105%;transform:translateX(-50%);
  font-size:10px;letter-spacing:3px;font-weight:800;color:var(--accent);
  white-space:nowrap;text-shadow:0 0 12px rgba(255,59,92,.9)}
@keyframes spinSlow{to{transform:rotate(360deg)}}

.hudReadout{position:absolute;left:14px;bottom:54px;z-index:6;pointer-events:none;
  font-family:ui-monospace,Menlo,Consolas,monospace;font-size:10px;line-height:1.75;
  letter-spacing:1.4px;color:rgba(160,190,230,.78);
  text-shadow:0 0 8px rgba(0,0,0,.95)}
.hudReadout b{color:var(--accent2)}

.camBar{position:absolute;left:50%;transform:translateX(-50%);bottom:16px;z-index:10;
  display:flex;gap:5px;padding:6px;border-radius:12px;
  background:rgba(6,9,15,.80);backdrop-filter:blur(14px);
  border:1px solid var(--line2);box-shadow:0 8px 30px rgba(0,0,0,.55)}
.camBtn{background:transparent;border:1px solid transparent;color:var(--muted);
  font-size:10.5px;font-weight:700;letter-spacing:.7px;padding:7px 12px;
  border-radius:8px;cursor:pointer;white-space:nowrap;
  transition:color .18s,background .18s,box-shadow .18s}
.camBtn:hover{color:var(--fg);background:#111b30}
.camBtn.on{color:#06090f;background:linear-gradient(135deg,var(--accent2),#1a4b8a);
  box-shadow:0 0 16px rgba(59,163,255,.45)}

/* ==================================================================
   ALERT BANNER + FLASH (real-time detection)
   ================================================================== */
.alertBanner{position:absolute;top:0;left:0;right:0;z-index:12;
  background:linear-gradient(90deg,#3a0010,#7a0016 45%,#3a0010);
  border-bottom:2px solid var(--accent);
  display:flex;align-items:center;gap:14px;padding:9px 18px;
  transform:translateY(-110%);transition:transform .45s cubic-bezier(.2,.9,.2,1);
  box-shadow:0 10px 40px rgba(255,0,50,.35)}
.alertBanner.show{transform:translateY(0)}
.alertBanner .abIcon{font-size:20px;animation:recPulse 1s infinite}
.alertBanner .abText{flex:1;font-size:12.5px;line-height:1.4}
.alertBanner .abText b{color:#fff;font-size:13.5px;letter-spacing:.4px}
.alertBanner .abText span{color:#ffc9d3}
.alertBanner button{background:#fff;color:#7a0016;border:none;font-weight:800;
  font-size:10.5px;letter-spacing:.6px;padding:7px 13px;border-radius:7px;cursor:pointer;
  transition:transform .1s,filter .15s}
.alertBanner button:hover{filter:brightness(.92)}
.alertBanner button.ghostB{background:transparent;border:1px solid rgba(255,255,255,.45);
  color:#fff}
.alertBanner button.ghostB:hover{background:rgba(255,255,255,.12)}
@keyframes recPulse{0%,100%{filter:brightness(1)}50%{filter:brightness(1.5)}}

.flash{position:absolute;inset:0;pointer-events:none;z-index:11;opacity:0;
  background:radial-gradient(ellipse at center, rgba(255,59,92,.55), rgba(255,0,40,0) 68%);
  transition:opacity .55s ease-out}
.flash.on{opacity:1;transition:opacity .05s}

/* ==================================================================
   CCTV MODAL
   ================================================================== */
.cctvModal{position:fixed;inset:0;background:rgba(2,4,10,.88);backdrop-filter:blur(8px);
  z-index:400;display:none;align-items:center;justify-content:center;padding:20px}
.cctvModal.show{display:flex}
.cctvInner{width:min(1100px,96vw);max-height:92vh;overflow:auto;
  background:var(--panel);border:1px solid var(--line2);border-radius:14px;
  box-shadow:0 30px 80px rgba(0,0,0,.75)}
.cctvHead{display:flex;align-items:center;gap:12px;padding:12px 16px;
  background:var(--panel3);border-bottom:1px solid var(--line)}
.cctvHead .ttl{font-weight:800;font-size:13px;letter-spacing:.6px;flex:1;
  display:flex;align-items:center;gap:9px}
.cctvHead .rec{display:inline-flex;align-items:center;gap:6px;font-size:10px;
  color:#ff8ba0;font-weight:800;letter-spacing:1px}
.cctvHead .rec::before{content:"";width:8px;height:8px;border-radius:50%;
  background:var(--accent);box-shadow:0 0 10px var(--accent);animation:pulse 1.1s infinite}
.cctvHead button{background:transparent;border:1px solid var(--line);color:var(--fg);
  border-radius:8px;padding:5px 12px;cursor:pointer;font-size:12px;font-weight:700}
.cctvHead button:hover{border-color:var(--accent);color:var(--accent)}

.wallGrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:12px}
.feedBox{position:relative;background:#000;border:1px solid var(--line);border-radius:10px;
  overflow:hidden}
.feedBox.active{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent),
  inset 0 0 40px rgba(255,59,92,.15)}
.feedBox canvas{display:block;width:100%;height:auto;background:#000}
.feedBox .fTag{position:absolute;left:8px;top:8px;font-size:9.5px;font-weight:800;
  letter-spacing:1px;color:#8ecbff;background:rgba(0,0,0,.6);padding:3px 7px;
  border-radius:5px;font-family:ui-monospace,monospace}
.feedBox .fAlert{position:absolute;right:8px;top:8px;font-size:9.5px;font-weight:900;
  letter-spacing:1px;color:#fff;background:var(--accent);padding:3px 8px;border-radius:5px;
  animation:recPulse 1s infinite}

.cctvMeta{padding:0 16px 12px;font-size:11.5px;color:var(--muted);line-height:1.7}
.cctvMeta b{color:var(--fg)}
.cctvActions{display:flex;gap:10px;padding:0 16px 16px}
.cctvActions button{flex:1}

/* MAPLIBRE OVERRIDES */
.maplibregl-popup-content{background:#0b1220!important;color:var(--fg)!important;
  border:1px solid var(--line2)!important;border-radius:12px!important;
  padding:14px!important;font-size:12px!important;font-family:Inter,sans-serif!important;
  line-height:1.5!important;box-shadow:0 12px 40px rgba(0,0,0,.65)!important}
.maplibregl-popup-tip{border-top-color:#0b1220!important;border-bottom-color:#0b1220!important;
  border-left-color:#0b1220!important;border-right-color:#0b1220!important}
.maplibregl-popup-close-button{color:var(--muted)!important;font-size:20px!important;
  padding:2px 8px!important;line-height:1!important}
.maplibregl-popup-close-button:hover{color:var(--accent)!important;background:transparent!important}
.maplibregl-ctrl-group{background:#0b1220!important;border:1px solid var(--line)!important;
  border-radius:8px!important;overflow:hidden}
.maplibregl-ctrl button{background-color:transparent!important;border-color:var(--line)!important}
.maplibregl-ctrl button+button{border-top:1px solid var(--line)!important}
.maplibregl-ctrl button span{filter:invert(1) brightness(1.2)}
.maplibregl-ctrl-attrib{background:rgba(6,9,15,.75)!important;color:var(--muted)!important;
  font-size:10px!important}
.maplibregl-ctrl-attrib a{color:var(--accent2)!important}
.maplibregl-ctrl-scale{background:rgba(6,9,15,.75)!important;color:var(--muted)!important;
  border-color:var(--line)!important}

/* RESPONSIVE */
@media (max-width: 1200px){
  main{grid-template-columns:260px 1fr 300px}
}
@media (max-width: 900px){
  main{grid-template-columns:1fr}
  .leftPanel,.rightPanel{position:absolute;top:0;bottom:0;width:280px;z-index:6;
                          box-shadow:0 0 30px rgba(0,0,0,.6)}
  .leftPanel{left:0;transform:translateX(-100%);transition:transform .25s}
  .rightPanel{right:0;transform:translateX(100%);transition:transform .25s}
  .leftPanel.open,.rightPanel.open{transform:translateX(0)}
  .search input{width:140px}
  .search input:focus{width:180px}
  .camBar{transform:translateX(-50%) scale(.82)}
  .wallGrid{grid-template-columns:1fr}
}
</style>
</head>
<body>

<!-- LOADER -->
<div id="loader">
  <div class="spin"></div>
  <div class="lTitle">CRIME<span>MAP</span></div>
  <div class="lText" id="lText">Initialising system…</div>
  <div class="lBar"><div id="lProg"></div></div>
</div>

<!-- NOTIFICATIONS DRAWER -->
<div class="notifDrawer" id="notifDrawer">
  <h4>Notifications <button class="act ghost sm" style="width:auto;padding:3px 10px"
      onclick="clearNotifs()">Clear</button></h4>
  <div class="notifList" id="notifList">
    <div class="notif green">System initialised. All engines online.
      <div class="t">just now</div></div>
  </div>
</div>

<!-- CCTV WALL MODAL -->
<div class="cctvModal" id="cctvModal">
  <div class="cctvInner">
    <div class="cctvHead">
      <div class="ttl"><span class="rec">LIVE</span><span id="cctvTitle">CAMERA WALL</span></div>
      <button onclick="closeCCTV()">✕ CLOSE</button>
    </div>
    <div class="wallGrid" id="wallGrid"></div>
    <div class="cctvMeta" id="cctvMeta"></div>
    <div class="cctvActions">
      <button class="act" id="cctvDispatch" onclick="dispatchFromCCTV()">🚔 DISPATCH NEAREST UNIT</button>
      <button class="act ghost" onclick="ackFromCCTV()">✔ MARK ACKNOWLEDGED</button>
    </div>
  </div>
</div>

<div id="app">
  <header>
    <div class="brand">
      <div class="logo">C</div>
      <div>
        <div class="title">CRIME<span>MAP</span> · Puducherry Police</div>
        <div class="subtitle">Developed by <b>Santhosh</b> · Lead Developer</div>
      </div>
    </div>
    <div class="headerRight">
      <div class="search"><input id="searchBox" type="text" placeholder="Search hotspots, stations, cameras…"/></div>
      <button class="bell" id="bellBtn" title="Notifications">
        🔔<span class="dot" id="notifCount">1</span>
      </button>
      <div class="clock">
        <div id="clockDate" style="color:var(--fg);font-weight:600">—</div>
        <div id="clockTime">—</div>
      </div>
    </div>
  </header>

  <nav class="tabs" id="tabs">
    <button data-tab="command" class="active">🗺 Command Center <span class="key">1</span></button>
    <button data-tab="livewatch" class="live">🎥 Live Watch <span class="key">2</span>
      <span class="liveDot" id="tabLiveDot" style="display:none"></span></button>
    <button data-tab="analytics">📊 Analytics <span class="key">3</span></button>
    <button data-tab="patrol">🚔 Patrol Planner <span class="key">4</span></button>
    <button data-tab="reports">📢 Citizen Reports <span class="key">5</span></button>
  </nav>

  <main>

    <!-- ================= LEFT PANELS ================= -->
    <aside class="leftPanel">

      <!-- COMMAND -->
      <div class="panelSet active" data-panel="command-left">
        <div class="card">
          <h3>Command Summary</h3>
          <div class="stat"><span>Total incidents</span><b id="sTotal">—</b></div>
          <div class="stat"><span>Last 7 days</span><b id="sLast7" class="gold">—</b></div>
          <div class="stat"><span>Active hotspots</span><b id="sHot" class="accent">—</b></div>
          <div class="stat"><span>Live detections</span><b id="sLive" class="accent">0</b></div>
          <div class="stat"><span>Patrol units</span><b id="sUnits" class="ok">8</b></div>
        </div>

        <div class="card">
          <h3>Filters <span class="right" id="filterCount">— shown</span></h3>
          <label class="lbl">Time window</label>
          <select id="fDays">
            <option value="7">Last 7 days</option>
            <option value="30">Last 30 days</option>
            <option value="90" selected>Last 90 days</option>
            <option value="180">Last 180 days</option>
            <option value="365">Full year</option>
          </select>
          <label class="lbl">Crime type</label>
          <select id="fCrime"><option value="all">All crimes</option></select>
          <label class="lbl">Police station</label>
          <select id="fStation"><option value="all">All stations</option></select>
          <label class="lbl">Minimum severity</label>
          <select id="fSev">
            <option value="1">All severities</option>
            <option value="2">≥ 2</option>
            <option value="3">≥ 3</option>
            <option value="4">≥ 4 (serious)</option>
          </select>
          <div class="row" style="margin-top:12px">
            <button class="act ghost sm" onclick="resetFilters()">Reset</button>
            <button class="act sec sm" onclick="exportCSV()">Export CSV</button>
          </div>
        </div>

        <div class="card">
          <h3>Map Layers</h3>
          <label class="toggle"><input type="checkbox" id="lHeat" checked/> Heatmap</label>
          <label class="toggle"><input type="checkbox" id="lPoints" checked/> Incident points</label>
          <label class="toggle"><input type="checkbox" id="lHot" checked/> Hotspot clusters</label>
          <label class="toggle"><input type="checkbox" id="lPredict"/> Predicted risk (7-day)</label>
          <label class="toggle"><input type="checkbox" id="lEmerging"/> Emerging alerts</label>
          <label class="toggle"><input type="checkbox" id="lStations" checked/> Police stations</label>
          <label class="toggle"><input type="checkbox" id="lPatrol"/> Patrol routes</label>
          <label class="toggle"><input type="checkbox" id="lUser"/> My location</label>
          <label class="toggle"><input type="checkbox" id="lBeams" checked/> Data beams</label>
          <label class="toggle"><input type="checkbox" id="lTowers" checked/> 3D risk towers</label>
          <label class="toggle"><input type="checkbox" id="lCams" checked/> CCTV network</label>
          <label class="toggle"><input type="checkbox" id="lFov" checked/> Camera FOV cones</label>
          <label class="toggle"><input type="checkbox" id="lDet" checked/> Live detections</label>
        </div>
      </div>

      <!-- LIVE WATCH -->
      <div class="panelSet" data-panel="livewatch-left">
        <div class="card">
          <h3>AI Detection Engine <span class="right" id="engineStatus">RUNNING</span></h3>
          <label class="toggle"><input type="checkbox" id="detRun" checked/> Detection engine active</label>
          <label class="toggle"><input type="checkbox" id="detAutoFly" checked/> Auto-focus on detection</label>
          <label class="toggle"><input type="checkbox" id="detAudio" checked/> Audible alarm</label>
          <label class="toggle"><input type="checkbox" id="detAutoDispatch"/> Auto-dispatch nearest unit</label>

          <label class="lbl">Detection sensitivity <b id="sensVal" style="color:var(--accent2)">MEDIUM</b></label>
          <input type="range" id="detSens" min="0" max="100" value="50"/>

          <div class="row" style="margin-top:12px">
            <button class="act" onclick="forceDetection()">⚠ SIMULATE DETECTION</button>
          </div>
          <div class="row">
            <button class="act ghost sm" onclick="openCCTVWall()">🎥 OPEN CAMERA WALL</button>
          </div>
        </div>

        <div class="card">
          <h3>Camera Network <span class="right" id="camCount">—</span></h3>
          <div class="stat"><span>Online</span><b id="camOnline" class="ok">—</b></div>
          <div class="stat"><span>PTZ units</span><b id="camPTZ" class="gold">—</b></div>
          <div class="stat"><span>Fixed units</span><b id="camFixed" class="blue">—</b></div>
          <div style="max-height:260px;overflow:auto;margin-top:10px" id="camList"></div>
        </div>
      </div>

      <!-- ANALYTICS -->
      <div class="panelSet" data-panel="analytics-left">
        <div class="card">
          <h3>Key Indicators</h3>
          <div class="kpi red">
            <div class="label">Incidents (90d)</div>
            <div class="value" id="kInc">—</div>
            <div class="delta" id="kIncD">—</div>
          </div>
          <div class="kpi gold">
            <div class="label">Hotspots detected</div>
            <div class="value" id="kHot">—</div>
            <div class="delta">Clustered via DBSCAN-style</div>
          </div>
          <div class="kpi blue">
            <div class="label">Peak hour</div>
            <div class="value" id="kPeak">—</div>
            <div class="delta">Most incidents occur here</div>
          </div>
          <div class="kpi green">
            <div class="label">Top crime</div>
            <div class="value" id="kTop" style="font-size:18px">—</div>
            <div class="delta">By volume</div>
          </div>
        </div>
      </div>

      <!-- PATROL -->
      <div class="panelSet" data-panel="patrol-left">
        <div class="card">
          <h3>Patrol Configuration</h3>
          <label class="lbl">Patrol units available</label>
          <input id="pUnits" type="number" value="8" min="1" max="15"/>
          <label class="lbl">Time budget per unit (minutes)</label>
          <input id="pHorizon" type="number" value="120" min="30" max="480"/>
          <label class="lbl">Prioritize by</label>
          <select id="pPriority">
            <option value="risk">Highest risk first</option>
            <option value="recent">Most recent activity</option>
            <option value="severity">Highest severity</option>
          </select>
          <div class="row">
            <button class="act" onclick="runPatrol()">⚡ Optimize Routes</button>
          </div>
          <div class="row">
            <button class="act ghost sm" onclick="clearPatrol()">Clear Routes</button>
            <button class="act ghost sm" onclick="exportRoutes()">Export Routes</button>
          </div>
          <div id="patrolInfo" style="font-size:11.5px;color:var(--muted);margin-top:12px;line-height:1.6"></div>
        </div>
      </div>

      <!-- REPORTS -->
      <div class="panelSet" data-panel="reports-left">
        <div class="card">
          <h3>Citizen Report</h3>
          <label class="lbl">Category</label>
          <select id="rCat">
            <option>Traffic obstruction</option>
            <option>Unauthorized parking</option>
            <option>Suspicious activity</option>
            <option>Unsafe area / poor lighting</option>
            <option>Noise / public nuisance</option>
            <option>Stray animal hazard</option>
            <option>Other</option>
          </select>
          <label class="lbl">Description</label>
          <textarea id="rDesc" placeholder="Describe what you observed…"></textarea>
          <div class="row">
            <button class="act ghost sm" onclick="useMyLocation()">📍 Use my location</button>
          </div>
          <div class="row">
            <button class="act ok" onclick="sendReport()">📤 Submit Report</button>
          </div>
          <div id="rMsg" style="font-size:11.5px;color:var(--ok);margin-top:8px;min-height:14px"></div>
        </div>

        <div class="card">
          <h3>Report Statistics</h3>
          <div class="stat"><span>Total reports</span><b id="rTotal">0</b></div>
          <div class="stat"><span>Today</span><b id="rToday" class="gold">0</b></div>
          <div class="stat"><span>Last 7 days</span><b id="rWeek" class="ok">0</b></div>
          <div class="stat"><span>Pending review</span><b id="rPend" class="accent">0</b></div>
        </div>
      </div>

    </aside>

    <!-- ================= MAP ================= -->
    <section class="mapWrap" id="mapWrap">
      <div id="map"></div>

      <div class="vignette"></div>
      <div class="scanline"></div>
      <div class="letterbox top"></div>
      <div class="letterbox bottom"></div>
      <div class="flash" id="flash"></div>

      <div class="hudCorners">
        <span class="c tl"></span><span class="c tr"></span>
        <span class="c bl"></span><span class="c br"></span>
      </div>

      <div class="reticle" id="reticle">
        <div class="ring"></div>
        <div class="dot"></div>
        <div class="cn tl"></div><div class="cn tr"></div>
        <div class="cn bl"></div><div class="cn br"></div>
        <div class="reticleLabel" id="reticleLabel">TARGET LOCK</div>
      </div>

      <div class="hudReadout">
        <div id="hudCoord">LAT — · LON — · Z— · BRG —</div>
        <div id="hudMode">MODE: <b>ORBITAL RECON</b></div>
      </div>

      <!-- REAL-TIME ALERT BANNER -->
      <div class="alertBanner" id="alertBanner">
        <span class="abIcon">🚨</span>
        <div class="abText" id="alertText">
          <b>VIOLENCE DETECTED</b><br/><span>—</span>
        </div>
        <button id="abDispatch">DISPATCH</button>
        <button class="ghostB" id="abFeed">VIEW FEED</button>
        <button class="ghostB" id="abDismiss">DISMISS</button>
      </div>

      <div class="camBar">
        <button class="camBtn on" id="btnOrbit" title="Auto-orbit when idle">🛰 ORBIT</button>
        <button class="camBtn on" id="btn3D" title="Real 3D city buildings">🏙 3D</button>
        <button class="camBtn on" id="btnTilt" title="Toggle camera tilt">⛰ TILT</button>
        <button class="camBtn on" id="btnRadar" title="Radar sweep">📡 RADAR</button>
        <button class="camBtn" id="btnCamFov" title="Toggle CCTV field-of-view cones">🎥 CAM FOV</button>
      </div>

      <div class="mapOverlayTop">
        <span class="pill live">Live</span>
        <span class="pill" id="pillCount">— incidents</span>
        <span class="pill on" id="pillHot">— hotspots</span>
        <span class="pill blue" id="pillCam">— cameras</span>
        <span class="pill red" id="pillDet" style="display:none">0 detections</span>
      </div>

      <div class="mapOverlayBottom">
        <div style="color:var(--muted);font-size:10px;letter-spacing:.9px;
                    margin-bottom:6px;text-transform:uppercase;font-weight:700">Risk Level</div>
        <div class="legend"><div class="sw" style="background:#26c281"></div>Low</div>
        <div class="legend"><div class="sw" style="background:#ffcc4d"></div>Medium</div>
        <div class="legend"><div class="sw" style="background:#ff7a3c"></div>High</div>
        <div class="legend"><div class="sw" style="background:#ff3b5c"></div>Critical</div>
        <div class="legend" style="margin-top:8px">
          <div class="sw" style="background:#ff3b5c;box-shadow:0 0 8px #ff3b5c"></div>
          <b style="color:#ff8ba0">AI Detection</b></div>
      </div>
    </section>

    <!-- ================= RIGHT PANELS ================= -->
    <aside class="rightPanel">

      <!-- COMMAND -->
      <div class="panelSet active" data-panel="command-right">
        <div class="card" style="border-color:#3a0c16">
          <h3 style="color:#ff8ba0">Live AI Detections <span class="right" id="detCountCmd">0</span></h3>
          <div id="detFeedCmd">
            <div style="color:var(--muted);font-size:11.5px">No active detections. Engine monitoring.</div>
          </div>
        </div>

        <div class="card">
          <h3>Top Hotspots <span class="right">click to lock on</span></h3>
          <div id="hotList" style="max-height:300px;overflow:auto">
            <div style="color:var(--muted);font-size:12px">Computing…</div>
          </div>
        </div>

        <div class="card">
          <h3>Recent Citizen Reports</h3>
          <div id="recentReports">
            <div style="color:var(--muted);font-size:11.5px">No reports yet.</div>
          </div>
        </div>
      </div>

      <!-- LIVE WATCH -->
      <div class="panelSet" data-panel="livewatch-right">
        <div class="card" style="border-color:#3a0c16">
          <h3 style="color:#ff8ba0">Detection Feed <span class="right" id="detCountLive">0</span></h3>
          <div id="detFeedLive">
            <div style="color:var(--muted);font-size:11.5px">Awaiting detections…</div>
          </div>
        </div>

        <div class="card">
          <h3>Emerging Hotspot Alerts</h3>
          <div id="emergeBox" style="max-height:220px;overflow:auto">
            <div style="color:var(--muted);font-size:11.5px">Analysing week-over-week growth…</div>
          </div>
        </div>
      </div>

      <!-- ANALYTICS -->
      <div class="panelSet" data-panel="analytics-right">
        <div class="card">
          <h3>Crime Type Distribution</h3>
          <div class="chartBox">
            <div id="chartDonut"></div>
          </div>
        </div>
        <div class="card">
