let state = {
  hotspots: [], emerging: [], predict: [], routes: null,
  filteredIncidents: [], activeTab: 'command'
};

/* ================= REFRESH ================= */
let refreshTimer = null;
function scheduleDataRefresh(){
  if (refreshTimer) return;
  refreshTimer = setTimeout(() => {
    refreshTimer = null;
    refreshAll();
  }, 2500);
}

function getFilters(){
  return {
    days: +document.getElementById('fDays').value,
    crime: document.getElementById('fCrime').value,
    station: document.getElementById('fStation').value,
    sev: +document.getElementById('fSev').value
  };
}
function applyFilters(){
  const f = getFilters();
  const cutoff = Date.now() - f.days*86400000;
  return INCIDENTS.filter(p =>
    p.ts >= cutoff &&
    (f.crime === 'all' || p.crime === f.crime) &&
    (f.station === 'all' || p.station === f.station) &&
    p.sev >= f.sev
  );
}

function refreshAll(){
  const filt = applyFilters();
  state.filteredIncidents = filt;

  const backup = INCIDENTS;
  INCIDENTS = filt;
  state.hotspots = detectHotspots(filt);
  state.emerging = emergingHotspots();
  state.predict  = predictRiskGrid();
  INCIDENTS = backup;

  map.getSource('incidents').setData({ type:'FeatureCollection', features: filt.map(p=>({
    type:'Feature',
    geometry:{ type:'Point', coordinates:[p.lon, p.lat] },
    properties:{ id:p.id, crime:p.crime, sev:p.sev, station:p.station,
                 ts:p.ts, loc:p.loc, status:p.status, mo:p.mo,
                 caseNo: p.caseNo || '' }
  }))});

  map.getSource('hotspots').setData({ type:'FeatureCollection',
    features: state.hotspots.map(h=>({
      type:'Feature', geometry:{ type:'Point', coordinates:[h.lon, h.lat] },
      properties: h
    }))
  });

  map.getSource('emerging').setData({ type:'FeatureCollection',
    features: state.emerging.map(a=>({
      type:'Feature', geometry:{ type:'Point', coordinates:[a.lon, a.lat] },
      properties: a
    }))
  });

  if (document.getElementById('lPredict').checked){
    map.getSource('predict').setData({ type:'FeatureCollection',
      features: state.predict.map(g=>({
        type:'Feature', geometry:{ type:'Point', coordinates:[g.lon, g.lat] },
        properties: g
      }))
    });
  }

  updateCineSources();
  updateSummary(filt);
  updateHotspotList();
  updateEmergingList();
  updateAnalytics(filt);
  updateReportsUI();
  updateFooter();
}

