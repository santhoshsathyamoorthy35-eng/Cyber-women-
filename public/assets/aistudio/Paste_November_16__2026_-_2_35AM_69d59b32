  for (const p of state.filteredIncidents){
    rows.push([p.caseNo||'', p.id, p.crime, p.sev, p.station,
      new Date(p.ts).toISOString(), p.lat.toFixed(5), p.lon.toFixed(5),
      p.loc, p.status, p.mo, p.source||'FIR']);
  }
  const csv = rows.map(r => r.map(c => `"${String(c).replace(/"/g,'""')}"`).join(',')).join('\n');
  download(csv, 'crimemap_incidents.csv', 'text/csv');
