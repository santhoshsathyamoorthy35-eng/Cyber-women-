/* ==================================================================
   AI DETECTION ENGINE
   ================================================================== */
const DETECT = {
  running: true,
  sensitivity: 0.5,
  autoFly: true,
  audio: true,
  autoDispatch: false,
  nextAt: 0
};

let liveDetections = [];
let detSeq = 0;
let dispatchFeatures = [];
let activeDetectionId = null;   // the one shown in banner / modal

function scheduleNextDetection(now){
  const s = DETECT.sensitivity;
  const base = 34000 - s*28000;                 // 34 s (low) → 6 s (high)
  const jitter = base * (0.45 + Math.random()*0.9);
  DETECT.nextAt = now + jitter;
}

function tickDetectionEngine(now){
  if (!DETECT.running) return;
  if (DETECT.nextAt === 0){ scheduleNextDetection(now); return; }
  if (now >= DETECT.nextAt){
    spawnDetection();
    scheduleNextDetection(now);
  }
}

function pickDetectionType(){
  const arr = Object.entries(DETECTION_TYPES).map(([k,v]) => ({ k, w:v.w }));
  return weightedPick(arr).k;
}

function spawnDetection(forcedCamId){
  const online = CAMERAS.filter(c => c.status === 'online');
  if (!online.length) return null;

  const cam = forcedCamId
    ? (CAMERAS.find(c => c.id === forcedCamId) || online[0])
    : online[Math.floor(Math.random()*online.length)];

  const typeName = pickDetectionType();
  const spec = DETECTION_TYPES[typeName];

  /* position: inside the camera's FOV cone, part-way out */
  const dist = (0.35 + Math.random()*0.55) * cam.range;
  const ang  = (cam.bearing + (Math.random()-0.5)*cam.fov*0.85) * Math.PI/180;
  const R = 6371000;
  const dx = Math.sin(ang)*dist, dy = Math.cos(ang)*dist;
  const lat = cam.lat + (dy/R)*180/Math.PI;
  const lon = cam.lon + (dx/(R*Math.cos(cam.lat*Math.PI/180)))*180/Math.PI;

  const det = {
    id: 'DET-' + pad(++detSeq, 4),
    camId: cam.id,
    camName: cam.name,
    lat, lon,
    type: typeName,
    severity: spec.sev,
    ipc: spec.ipc,
    color: spec.color,
    confidence: +(0.74 + Math.random()*0.25).toFixed(2),
    bornAt: Date.now(),
    status: 'new',
    caseNo: newCaseNo(),
    unit: null,
    station: nearestStation(lat, lon),
    seed: Math.random()*6.28
  };

  liveDetections.unshift(det);
  if (liveDetections.length > 60) liveDetections.pop();

  /* --- also register it into the operational incident database --- */
  INCIDENTS.push({
    id: 900000 + detSeq,
    crime: mapDetTypeToCrime(typeName),
    sev: spec.sev,
    caseNo: det.caseNo,
    station: det.station,
    ts: det.bornAt,
    lat, lon,
    loc: 'CCTV detection',
    status: 'Reported',
    mo: 'camera-ai',
    source: 'CCTV',
    camId: cam.id
  });
  scheduleDataRefresh();

  /* --- visual + audio alarm --- */
  onDetectionRaised(det);
  return det;
}

function mapDetTypeToCrime(t){
  switch(t){
    case 'Physical Assault':
    case 'Group Fight':        return 'Assault';
    case 'Weapon Detected':    return 'Assault';
    case 'Chain Snatching':
    case 'Robbery In Progress':return 'Snatching';
    case 'Vehicle Collision':
    case 'Person Down / Fall': return 'Traffic Violation';
    case 'Crowd Surge':        return 'Public Nuisance';
    case 'Suspicious Loitering':return 'Public Nuisance';
    case 'Vandalism':          return 'Public Nuisance';
    default:                   return 'Theft';
  }
}

function onDetectionRaised(det){
  /* 1. dramatic red flash + reticle */
  flashScreen();
  showReticle(true, det.severity >= 4 ? 'THREAT DETECTED' : 'EVENT DETECTED');
  setTimeout(() => showReticle(false), 2200);

  /* 2. alarm tone */
  if (DETECT.audio) playAlarm(det.severity);

  /* 3. banner */
  activeDetectionId = det.id;
  showAlertBanner(det);

  /* 4. notification */
  addNotification(
    `🚨 ${det.type} — ${det.camName} (${Math.round(det.confidence*100)}% conf.)`,
    det.severity >= 4 ? 'red' : 'gold'
  );

  /* 5. toast */
  toast(`🚨 ${det.type} detected · ${det.camId}`, 'err');

  /* 6. camera shake pulse on tab indicator */
  const dot = document.getElementById('tabLiveDot');
  if (dot) dot.style.display = 'inline-block';

  /* 7. refresh detection panels */
  renderDetections();

  /* 8. camera fly (respects user toggle) */
  if (DETECT.autoFly){
    flyTo(det.lat, det.lon, 17.2);
  }

  /* 9. auto-dispatch if enabled */
  if (DETECT.autoDispatch && det.severity >= 4){
    setTimeout(() => dispatchToDetection(det.id, true), 900);
  }
}

/* ---- audio alarm (Web Audio API, no files) ---- */
let audioCtx = null;
function unlockAudio(){
  try{
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
  }catch(e){}
}
document.addEventListener('click', unlockAudio, { once:false });

function playAlarm(severity){
  try{
    unlockAudio();
    if (!audioCtx) return;
    const now = audioCtx.currentTime;
    const beeps = severity >= 4 ? 3 : 2;

    for (let i=0;i<beeps;i++){
      const t0 = now + i*0.26;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'square';
      osc.frequency.setValueAtTime(i % 2 === 0 ? 920 : 660, t0);
      gain.gain.setValueAtTime(0.0001, t0);
      gain.gain.exponentialRampToValueAtTime(0.075, t0 + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.20);
      osc.connect(gain).connect(audioCtx.destination);
      osc.start(t0);
      osc.stop(t0 + 0.24);
    }
  }catch(e){ /* silently ignore */ }
}

/* ---- alert banner ---- */
function showAlertBanner(det){
  const banner = document.getElementById('alertBanner');
  const txt = document.getElementById('alertText');
  if (!banner || !txt) return;

  txt.innerHTML =
    `<b>${det.type.toUpperCase()}${det.severity >= 4 ? ' — VIOLENCE DETECTED' : ''}</b><br/>
     <span>${det.camId} · ${det.camName} · confidence ${Math.round(det.confidence*100)}% ·
     ${det.ipc} · CASE ${det.caseNo}</span>`;

  banner.classList.add('show');

  document.getElementById('abDispatch').onclick = () => dispatchToDetection(det.id);
  document.getElementById('abFeed').onclick     = () => openCCTV(det.camId, det.id);
  document.getElementById('abDismiss').onclick  = () => banner.classList.remove('show');

  clearTimeout(showAlertBanner._t);
  showAlertBanner._t = setTimeout(() => banner.classList.remove('show'),
    det.severity >= 4 ? 16000 : 10000);
}

/* ---- dispatch ---- */
function dispatchToDetection(id, silent){
  const det = liveDetections.find(d => d.id === id);
  if (!det) return;
  if (det.status === 'dispatched'){
    if (!silent) toast('Unit already dispatched to this location', 'warn');
    return;
  }

  const st = nearestStationObj(det.lat, det.lon);
  const unitNo = Math.floor(Math.random()*8) + 1;
  det.status = 'dispatched';
  det.unit = 'PCR-' + pad(unitNo, 2);
  det.dispatchedAt = Date.now();
  det.etaMin = Math.max(2, Math.round(haversineKm(st[1], st[2], det.lat, det.lon) / 25 * 60));

  dispatchFeatures.push({
    type:'Feature',
    geometry:{ type:'LineString',
      coordinates: arcCoords([st[2], st[1]], [det.lon, det.lat], 44, 0.12) },
    properties:{ color:'#26c281' }
  });
  updateDispatchLayer();

  /* record the response in the incident DB */
  const inc = INCIDENTS.find(i => i.caseNo === det.caseNo);
  if (inc){ inc.status = 'Investigating'; inc.unit = det.unit; }

  renderDetections();
  updateSummary(state.filteredIncidents);

  toast(`🚔 ${det.unit} dispatched from ${st[0]} — ETA ${det.etaMin} min`);
  addNotification(`Unit ${det.unit} dispatched to ${det.camName} · ETA ${det.etaMin} min`, 'green');

  showReticle(true, 'UNIT DISPATCHED');
  map.easeTo({ pitch: 68, duration: 1100, essential:true });
  setTimeout(() => showReticle(false), 2000);

  const banner = document.getElementById('alertBanner');
  if (banner) banner.classList.remove('show');
}

function updateDispatchLayer(){
  if (!map.getSource('dispatch')) return;
  map.getSource('dispatch').setData({
    type:'FeatureCollection',
    features: dispatchFeatures.slice(-30)
  });
}

function acknowledgeDetection(id){
  const det = liveDetections.find(d => d.id === id);
  if (!det) return;
  if (det.status === 'dispatched'){ toast('Already dispatched', 'warn'); return; }
  det.status = 'ack';
  det.ackedAt = Date.now();
  renderDetections();
  toast('✔ Detection acknowledged');
}

function resolveDetection(id){
  const det = liveDetections.find(d => d.id === id);
  if (!det) return;
  det.status = 'resolved';
  renderDetections();
  updateSummary(state.filteredIncidents);
  toast('Detection resolved');
}

function clearResolved(){
  liveDetections = liveDetections.filter(d => d.status !== 'resolved');
  renderDetections();
  updateSummary(state.filteredIncidents);
  toast('Resolved detections cleared');
}

/* ---- detection rendering ---- */
function renderDetections(){
  const active = liveDetections.filter(d => d.status !== 'resolved');
  const counts = {
    cmd:  document.getElementById('detCountCmd'),
    live: document.getElementById('detCountLive')
  };
  if (counts.cmd)  counts.cmd.textContent  = active.length;
  if (counts.live) counts.live.textContent = active.length;

  const pillDet = document.getElementById('pillDet');
  if (pillDet){
    pillDet.style.display = active.length ? 'inline-flex' : 'none';
    pillDet.textContent = active.length + ' detection' + (active.length === 1 ? '' : 's');
  }
  const sLive = document.getElementById('sLive');
  if (sLive) sLive.textContent = active.length;

  const dot = document.getElementById('tabLiveDot');
  if (dot) dot.style.display = active.some(d => d.status === 'new') ? 'inline-block' : 'none';

  const html = (det) => `
    <div class="detCard ${det.status==='dispatched'?'dispatched':''} ${det.status==='ack'?'ack':''}"
         onclick="focusDetection('${det.id}')">
      <div class="ttl">${det.severity>=4?'🔴':'🟠'} ${det.type}</div>
      <div class="meta">
        ${det.camId} · ${det.camName}<br/>
        ${new Date(det.bornAt).toLocaleTimeString('en-IN',{hour12:false})} ·
        ${det.station.replace(' PS','')} jurisdiction<br/>
        Case ${det.caseNo} · ${det.ipc}
      </div>
      <div class="confBar"><div style="width:${Math.round(det.confidence*100)}%"></div></div>
      <div class="meta" style="margin-top:4px">
        AI confidence <b style="color:var(--accent2)">${Math.round(det.confidence*100)}%</b>
        ${det.unit ? ` · <b style="color:var(--ok)">${det.unit} en route (ETA ${det.etaMin}m)</b>` : ''}
      </div>
      <div class="acts">
        ${det.status==='new'
          ? `<button class="go" onclick="event.stopPropagation();dispatchToDetection('${det.id}')">
               🚔 DISPATCH</button>`
          : det.status==='dispatched'
            ? `<button onclick="event.stopPropagation();resolveDetection('${det.id}')">
                 ✔ RESOLVE</button>`
            : `<button class="go" onclick="event.stopPropagation();dispatchToDetection('${det.id}')">
                 🚔 DISPATCH</button>`}
        <button onclick="event.stopPropagation();openCCTV('${det.camId}','${det.id}')">
          🎥 FEED</button>
        ${det.status==='new'
          ? `<button onclick="event.stopPropagation();acknowledgeDetection('${det.id}')">
               ✔ ACK</button>`
          : `<button onclick="event.stopPropagation();resolveDetection('${det.id}')">
               ✔ RESOLVE</button>`}
      </div>
    </div>`;

  const cmdBox = document.getElementById('detFeedCmd');
  if (cmdBox){
    cmdBox.innerHTML = active.length
      ? active.slice(0,4).map(html).join('')
      : '<div style="color:var(--muted);font-size:11.5px">No active detections. Engine monitoring.</div>';
  }
  const liveBox = document.getElementById('detFeedLive');
  if (liveBox){
    liveBox.innerHTML = liveDetections.length
      ? liveDetections.slice(0,25).map(html).join('')
      : '<div style="color:var(--muted);font-size:11.5px">Awaiting detections…</div>';
  }
}

function focusDetection(id){
  const det = liveDetections.find(d => d.id === id);
  if (!det) return;
  flyTo(det.lat, det.lon, 17.4);
  openCCTV(det.camId, det.id);
}

function forceDetection(){
  const det = spawnDetection();
  if (det) toast('⚠ Simulated detection: ' + det.type, 'warn');
}

/* ==================================================================
   CCTV WALL / LIVE FEED
   ================================================================== */
let wallCameras = [];
let wallDetId = null;
let noisePattern = null;

function makeNoisePattern(){
  const c = document.createElement('canvas');
  c.width = c.height = 128;
  const ctx = c.getContext('2d');
  const img = ctx.createImageData(128,128);
  for (let i=0;i<img.data.length;i+=4){
    const v = Math.random()*255;
    img.data[i] = v; img.data[i+1] = v; img.data[i+2] = v;
    img.data[i+3] = Math.random()*34;
  }
  ctx.putImageData(img,0,0);
  return c;
}

function openCCTVWall(){
  const online = CAMERAS.filter(c => c.status === 'online');
  wallCameras = [];
  for (let i=0;i<4;i++) wallCameras.push(online[(i*5) % online.length]);
  wallDetId = null;
  buildWall();
  document.getElementById('cctvModal').classList.add('show');
  document.getElementById('cctvTitle').textContent = 'CAMERA WALL · 4-UP';
  document.getElementById('cctvMeta').innerHTML =
    `<b>${online.length}</b> cameras online · Puducherry CCTV grid · AI analytics active on all feeds`;
  document.getElementById('cctvDispatch').style.display = 'none';
}

function openCCTV(camId, detId){
  const cam = CAMERAS.find(c => c.id === camId);
  if (!cam){ toast('Camera not found', 'err'); return; }

  const online = CAMERAS.filter(c => c.status === 'online' && c.id !== camId);
  // main feed + 3 neighbours (nearest by distance)
  const sorted = online.slice().sort((a,b)=>
    (haversineKm(cam.lat,cam.lon,a.lat,a.lon)) - (haversineKm(cam.lat,cam.lon,b.lat,b.lon))
  );
  wallCameras = [cam, ...sorted.slice(0,3)];
  wallDetId = detId || null;

  buildWall();
  document.getElementById('cctvModal').classList.add('show');
  document.getElementById('cctvTitle').textContent =
    `${cam.id} · ${cam.name} · LIVE FEED`;

  const det = detId ? liveDetections.find(d => d.id === detId) : null;
  document.getElementById('cctvMeta').innerHTML = det
    ? `<b style="color:#ff8ba0">${det.type}</b> detected · Case <b>${det.caseNo}</b> ·
       ${det.ipc} · AI confidence <b>${Math.round(det.confidence*100)}%</b><br/>
       Jurisdiction: <b>${det.station}</b> ·
       ${det.unit ? `Unit <b style="color:#26c281">${det.unit}</b> en route (ETA ${det.etaMin} min)`
                  : 'No unit dispatched'}`
    : `Live feed · ${cam.type} unit · FOV ${cam.fov}° · range ${cam.range} m ·
       bearing ${cam.bearing}°`;

  const btn = document.getElementById('cctvDispatch');
  if (det && det.status === 'new'){
    btn.style.display = 'block';
    btn.onclick = () => { dispatchToDetection(det.id); closeCCTV(); };
  } else {
    btn.style.display = 'none';
  }
}

function buildWall(){
  const grid = document.getElementById('wallGrid');
  grid.innerHTML = wallCameras.map((c,i) => `
    <div class="feedBox ${i===0?'active':''}" id="feedBox${i}">
      <canvas id="feedCv${i}" width="640" height="360"></canvas>
      <div class="fTag">${c.id} · ${c.name}</div>
      <div class="fAlert" id="feedAlert${i}" style="display:none">⚠ ALERT</div>
    </div>`).join('');
}

function closeCCTV(){
  document.getElementById('cctvModal').classList.remove('show');
  wallCameras = [];
  wallDetId = null;
}

function dispatchFromCCTV(){
  if (wallDetId) dispatchToDetection(wallDetId);
}
function ackFromCCTV(){
  if (wallDetId) acknowledgeDetection(wallDetId);
}

/* ---- per-frame CCTV render ---- */
let wallFrame = 0;
function tickCCTVWall(now){
  if (!wallCameras.length) return;
  if (now - wallFrame < 66) return;   // ~15 fps
  wallFrame = now;
  if (!noisePattern) noisePattern = makeNoisePattern();

  wallCameras.forEach((cam, i) => {
    const cv = document.getElementById('feedCv' + i);
    if (!cv) return;
    const alertBox = document.getElementById('feedAlert' + i);
    const det = liveDetections.find(d =>
      d.camId === cam.id && d.status !== 'resolved' &&
      (Date.now() - d.bornAt) < 120000);

    if (alertBox) alertBox.style.display = det ? 'block' : 'none';
    drawFeed(cv, cam, det, now);
  });
}

function drawFeed(canvas, cam, det, now){
  const ctx = canvas.getContext('2d');
  const W = canvas.width, H = canvas.height;
  const t = now/1000;

  /* base */
  ctx.fillStyle = '#04070d';
  ctx.fillRect(0,0,W,H);

  /* pseudo street scene — road */
  const horizon = H*0.52;
  const grad = ctx.createLinearGradient(0,horizon-40,0,H);
  grad.addColorStop(0,'#0a1018');
  grad.addColorStop(1,'#05080d');
  ctx.fillStyle = grad;
  ctx.fillRect(0,horizon-40,W,H-horizon+40);

  /* buildings silhouettes */
  ctx.fillStyle = '#0b1320';
  for (let b=0;b<9;b++){
    const bw = 50 + ((b*37)%70);
    const bh = 40 + ((b*53)%90);
    const bx = (b*78 + Math.sin(t*0.06 + b)*3) % (W+80) - 40;
    ctx.fillRect(bx, horizon-bh, bw, bh);
    /* windows */
    ctx.fillStyle = 'rgba(120,180,255,0.10)';
    for (let wy=horizon-bh+8; wy<horizon-8; wy+=14){
      for (let wx=bx+7; wx<bx+bw-8; wx+=13){
        if (((wx*wy)>>4) % 3 === 0) ctx.fillRect(wx, wy, 5, 6);
      }
    }
    ctx.fillStyle = '#0b1320';
  }

  /* road markings */
  ctx.strokeStyle = 'rgba(180,200,230,0.16)';
  ctx.lineWidth = 3;
  ctx.setLineDash([26,20]);
  ctx.lineDashOffset = -(t*70) % 46;
  ctx.beginPath();
  ctx.moveTo(0, H*0.78);
  ctx.lineTo(W, H*0.78);
  ctx.stroke();
  ctx.setLineDash([]);

  /* moving figures */
  const figures = [];
  for (let p=0;p<3;p++){
    const speed = 0.18 + p*0.09;
    const px = ((t*speed*90 + p*230) % (W+120)) - 60;
    const py = H*0.72 + p*22 + Math.sin(t*3 + p)*3;
    const sc = 0.65 + p*0.28;
    figures.push({ x:px, y:py, s:sc, id:p });
    ctx.fillStyle = 'rgba(150,175,210,0.30)';
    ctx.beginPath();
    ctx.ellipse(px, py, 7*sc, 15*sc, 0, 0, Math.PI*2);
    ctx.fill();
    ctx.beginPath();
    ctx.arc(px, py-19*sc, 6*sc, 0, Math.PI*2);
    ctx.fill();
  }

  /* motion blur streaks */
  ctx.fillStyle = 'rgba(120,160,220,0.035)';
  for (let s=0;s<4;s++){
    const sy = (t*40 + s*90) % H;
    ctx.fillRect(0, sy, W, 2);
  }

  /* noise overlay */
  if (noisePattern){
    const pat = ctx.createPattern(noisePattern, 'repeat');
    ctx.save();
    ctx.globalAlpha = 0.55;
    ctx.translate(Math.random()*128, Math.random()*128);
    ctx.fillStyle = pat;
    ctx.fillRect(-128,-128,W+256,H+256);
    ctx.restore();
  }

  /* scanline */
  const scanY = (t*130) % H;
  ctx.fillStyle = 'rgba(140,200,255,0.055)';
  ctx.fillRect(0, scanY, W, 2);

  /* AI bounding box */
  if (det){
    const bx = W*0.36 + Math.sin(t*1.7)*9;
    const by = H*0.40 + Math.cos(t*2.1)*6;
    const bw = W*0.26, bh = H*0.50;

    ctx.strokeStyle = '#ff3b5c';
    ctx.lineWidth = 3;
    ctx.strokeRect(bx, by, bw, bh);

    /* corner ticks */
    ctx.lineWidth = 4;
    const tick = 18;
    ctx.beginPath();
    ctx.moveTo(bx, by+tick); ctx.lineTo(bx, by); ctx.lineTo(bx+tick, by);
    ctx.moveTo(bx+bw-tick, by); ctx.lineTo(bx+bw, by); ctx.lineTo(bx+bw, by+tick);
    ctx.moveTo(bx, by+bh-tick); ctx.lineTo(bx, by+bh); ctx.lineTo(bx+tick, by+bh);
    ctx.moveTo(bx+bw-tick, by+bh); ctx.lineTo(bx+bw, by+bh); ctx.lineTo(bx+bw, by+bh-tick);
    ctx.stroke();

    /* label */
    ctx.fillStyle = '#ff3b5c';
    ctx.fillRect(bx, by-24, 220, 22);
    ctx.fillStyle = '#fff';
    ctx.font = 'bold 13px ui-monospace, monospace';
    ctx.fillText(det.type.toUpperCase() + ' ' + Math.round(det.confidence*100) + '%', bx+8, by-8);

    /* target lines */
    ctx.strokeStyle = 'rgba(255,59,92,0.45)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(0, by+bh/2); ctx.lineTo(bx, by+bh/2);
    ctx.moveTo(bx+bw, by+bh/2); ctx.lineTo(W, by+bh/2);
    ctx.stroke();
  }

  /* HUD overlay */
  ctx.fillStyle = 'rgba(0,0,0,0.55)';
  ctx.fillRect(0,0,W,26);
  ctx.font = 'bold 12px ui-monospace, monospace';
  ctx.fillStyle = '#8ecbff';
  ctx.fillText(cam.id + '  ' + cam.name, 10, 17);

  ctx.textAlign = 'right';
  ctx.fillStyle = '#eaf0fb';
  ctx.fillText(new Date().toLocaleString('en-IN', {
    day:'2-digit', month:'2-digit', year:'numeric',
    hour:'2-digit', minute:'2-digit', second:'2-digit', hour12:false
  }), W-10, 17);
  ctx.textAlign = 'left';

  /* rec dot */
  ctx.fillStyle = (Math.floor(t*2) % 2) ? '#ff3b5c' : 'rgba(255,59,92,0.25)';
  ctx.beginPath();
  ctx.arc(W-16, H-16, 6, 0, Math.PI*2);
  ctx.fill();

  /* subtle vignette */
  const vg = ctx.createRadialGradient(W/2,H/2,H*0.25, W/2,H/2, H*0.85);
  vg.addColorStop(0,'rgba(0,0,0,0)');
  vg.addColorStop(1,'rgba(0,0,0,0.55)');
  ctx.fillStyle = vg;
  ctx.fillRect(0,0,W,H);
}

