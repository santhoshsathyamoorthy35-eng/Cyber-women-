function exportRoutes(){
  if (!state.routes){ toast('Optimize routes first', 'warn'); return; }
  const rows = [['unit','station','stop','risk','lat','lon']];
  for (const r of state.routes){
    for (const p of r.path){
      rows.push([r.unit, r.station, p.stop, p.risk||0, p.lat.toFixed(5), p.lon.toFixed(5)]);
    }
  }
  const csv = rows.map(r => r.join(',')).join('\n');
  download(csv, 'crimemap_patrol_routes.csv', 'text/csv');
  toast('✅ Exported patrol routes');
}

function download(content, name, mime){
  const blob = new Blob([content], { type: mime });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = name;
  document.body.appendChild(a); a.click();
  document.body.removeChild(a);
  setTimeout(()=> URL.revokeObjectURL(url), 1000);
}

/* ================= PATROL ================= */
function runPatrol(){
  const units = Math.max(1, Math.min(15, +document.getElementById('pUnits').value || 8));
  const horizon = Math.max(30, Math.min(480, +document.getElementById('pHorizon').value || 120));
  const priority = document.getElementById('pPriority').value;
  const info = document.getElementById('patrolInfo');
  info.innerHTML = '<span style="color:var(--accent2)">⚡ Optimizing patrol routes…</span>';
  document.getElementById('fStatus').textContent = 'Optimizing…';
  setHudMode('ROUTE OPTIMISATION');

  setTimeout(() => {
    const routes = optimizePatrols(units, horizon, priority);
    state.routes = routes;

    const colors = ['#ff3b5c','#3ba3ff','#26c281','#ffcc4d','#a06bff',
                    '#ff7a3c','#4fd1c5','#ff4fa3','#ffb03a','#8ecbff',
                    '#c3ff4d','#ff5e5e','#5e8fff','#7fffbf','#ffb0e0'];
    const features = [];
    routes.forEach((r, i) => {
      if (r.path.length < 2) return;
      const color = colors[i%colors.length];
      features.push({
        type:'Feature',
        geometry:{ type:'LineString', coordinates: r.path.map(p=>[p.lon, p.lat]) },
        properties:{ color, unit: r.unit, stops: r.stops }
      });
      r.path.forEach((p, idx) => {
        if (idx === 0) return;
        features.push({
          type:'Feature',
          geometry:{ type:'Point', coordinates:[p.lon, p.lat] },
          properties:{ color, unit: r.unit, risk: p.risk, stop: idx }
        });
      });
    });
    map.getSource('patrol').setData({ type:'FeatureCollection', features });

    const totalStops = routes.reduce((a,b) => a + b.stops, 0);
    const totalTime  = routes.reduce((a,b) => a + b.timeUsed, 0);
    info.innerHTML = `<b style="color:var(--gold)">✅ ${routes.length} units dispatched</b><br/>
      <b>${totalStops}</b> high-risk stops covered<br/>
      <b>${totalTime}</b> total patrol minutes<br/>
      <span class="badge blue">Engine: risk-weighted VRP</span>`;
    document.getElementById('routeCount').textContent = routes.length + ' units';

    document.getElementById('lPatrol').checked = true;
    map.setLayoutProperty('patrol-lines','visibility','visible');
    map.setLayoutProperty('patrol-stops','visibility','visible');

    const rl = document.getElementById('routeList');
    rl.innerHTML = routes.map((r, i) => `
      <div class="hot" onclick="zoomToRoute(${i})">
        <div class="l">
          <b>${r.unit}</b>
          <span class="meta">${r.station} · ${r.stops} stops · ${r.timeUsed} min</span>
          <span class="meta" style="color:var(--muted2);margin-top:2px;display:block">
            ${r.path.slice(1,4).map(p=>`R${p.risk}`).join(' → ')}${r.path.length>4?' → …':''}
          </span>
        </div>
        <div class="r" style="color:${colors[i%colors.length]}">${r.stops}</div>
      </div>`).join('');

    document.getElementById('fStatus').textContent = 'Patrol optimized';
    setHudMode('UNITS DEPLOYED');
    toast(`✅ ${totalStops} high-risk stops across ${routes.length} units`);
    addNotification(`Patrol optimized: ${totalStops} stops · ${routes.length} units`, 'gold');

    showReticle(true, 'UNITS DEPLOYED');
    map.easeTo({ pitch: 72, duration: 1400, essential:true });
    setTimeout(()=> showReticle(false), 2200);
  }, 80);
}

function zoomToRoute(i){
  if (!state.routes || !state.routes[i]) return;
  const r = state.routes[i];
  const lons = r.path.map(p=>p.lon), lats = r.path.map(p=>p.lat);
  const bounds = [[Math.min(...lons), Math.min(...lats)],
                  [Math.max(...lons), Math.max(...lats)]];
  map.fitBounds(bounds, { padding:90, duration:1100, pitch:66, bearing:-18 });
  showReticle(true, 'ROUTE ' + r.unit);
  setTimeout(()=> showReticle(false), 1500);
}

function clearPatrol(){
  map.getSource('patrol').setData(emptyFC());
  document.getElementById('patrolInfo').innerHTML = '';
  document.getElementById('routeList').innerHTML =
    '<div style="color:var(--muted);font-size:11.5px">Configure units on the left and click <b>Optimize Routes</b>.</div>';
  document.getElementById('routeCount').textContent = '—';
  state.routes = null;
  toast('Routes cleared');
}

/* ================= CITIZEN REPORTS ================= */
let userLoc = null;
function useMyLocation(){
  if (!navigator.geolocation){ toast('❌ Geolocation not supported', 'err'); return; }
  toast('📍 Getting your location…');
  navigator.geolocation.getCurrentPosition(pos => {
    userLoc = { lat: pos.coords.latitude, lon: pos.coords.longitude };
    toast(`📍 Captured: ${userLoc.lat.toFixed(4)}, ${userLoc.lon.toFixed(4)}`);
  }, () => {
    toast('❌ Could not get location — using approximate', 'warn');
  });
}

function sendReport(){
  const cat = document.getElementById('rCat').value;
  const desc = document.getElementById('rDesc').value.trim();
  if (!desc){
    document.getElementById('rMsg').style.color = '#ff3b5c';
    document.getElementById('rMsg').textContent = 'Please add a description.';
    return;
  }
  let lat = 11.9340, lon = 79.8300;
  if (userLoc){ lat = userLoc.lat; lon = userLoc.lon; }
  else { lat += (Math.random()-0.5)*0.005; lon += (Math.random()-0.5)*0.005; }

  const report = {
    id: Date.now(),
    category: cat, description: desc,
    lat, lon, status: 'Received',
    createdAt: new Date().toISOString()
  };
  citizenReports.unshift(report);
  citizenReports = citizenReports.slice(0, 100);
  localStorage.setItem('crimemap_reports_v2', JSON.stringify(citizenReports));

  document.getElementById('rMsg').style.color = '#26c281';
  document.getElementById('rMsg').textContent = '✅ Report sent to nearest station.';
  document.getElementById('rDesc').value = '';

  new maplibregl.Marker({ color: '#26c281' }).setLngLat([lon, lat]).addTo(map);

  updateReportsUI();
  flyTo(lat, lon, 16.5);
  toast('✅ Citizen report received — routed to station');
  addNotification(`New citizen report: ${cat}`, 'green');
}

function ackReport(id){
  const r = citizenReports.find(x => x.id === id);
  if (!r) return;
  r.status = 'Acknowledged';
  localStorage.setItem('crimemap_reports_v2', JSON.stringify(citizenReports));
  updateReportsUI();
  toast('Report acknowledged');
}

/* ================= NOTIFICATIONS ================= */
function addNotification(msg, type='green'){
  notifications.unshift({ msg, type, time: new Date() });
  notifications = notifications.slice(0, 40);
  renderNotifs();
}
function renderNotifs(){
  const list = document.getElementById('notifList');
  list.innerHTML = notifications.map(n => `
    <div class="notif ${n.type}">
      ${n.msg}
      <div class="t">${timeAgo(n.time)}</div>
    </div>`).join('');
  const count = notifications.length;
  const dot = document.getElementById('notifCount');
  dot.textContent = count;
  dot.style.display = count ? 'block' : 'none';
}
function clearNotifs(){ notifications = []; renderNotifs(); toast('Notifications cleared'); }
function timeAgo(d){
  const s = Math.floor((Date.now() - d.getTime())/1000);
  if (s < 60) return 'just now';
  if (s < 3600) return Math.floor(s/60) + ' min ago';
  if (s < 86400) return Math.floor(s/3600) + ' h ago';
  return Math.floor(s/86400) + ' d ago';
}

/* ================= TABS ================= */
function switchTab(tab){
  state.activeTab = tab;
  document.querySelectorAll('nav.tabs button').forEach(b => {
    b.classList.toggle('active', b.dataset.tab === tab);
  });
  document.querySelectorAll('.panelSet').forEach(p => {
    p.classList.toggle('active', p.dataset.panel === tab + '-left' ||
                                  p.dataset.panel === tab + '-right');
  });
  if (tab === 'analytics'){
    updateAnalytics(state.filteredIncidents);
  }
  if (tab === 'livewatch'){
    renderDetections();
  }
  document.getElementById('fStatus').textContent =
    { command:'Command view', livewatch:'Live surveillance',
      analytics:'Analytics view', patrol:'Patrol planner',
      reports:'Citizen reports' }[tab];
  setHudMode({
    command:'ORBITAL RECON', livewatch:'AI SURVEILLANCE',
    analytics:'ANALYTICS MODE', patrol:'PATROL PLANNER',
    reports:'CITIZEN FEED'
  }[tab]);
}

/* ================= UI WIRING ================= */
function wireUI(){
  ['fDays','fCrime','fStation','fSev'].forEach(id => {
    document.getElementById(id).addEventListener('change', refreshAll);
  });

  document.getElementById('lHeat').onchange = e =>
    map.setLayoutProperty('incidents-heat','visibility', e.target.checked ? 'visible':'none');
  document.getElementById('lPoints').onchange = e =>
    map.setLayoutProperty('incidents-points','visibility', e.target.checked ? 'visible':'none');
  document.getElementById('lHot').onchange = e => {
    const v = e.target.checked ? 'visible':'none';
    map.setLayoutProperty('hotspots-halo','visibility', v);
    map.setLayoutProperty('hotspots-label','visibility', v);
  };
  document.getElementById('lStations').onchange = e => {
    const v = e.target.checked ? 'visible':'none';
    map.setLayoutProperty('stations-halo','visibility', v);
    map.setLayoutProperty('stations-label','visibility', v);
  };
  document.getElementById('lPredict').onchange = e => {
    if (e.target.checked){
      const fc = { type:'FeatureCollection', features: state.predict.map(g=>({
        type:'Feature', geometry:{ type:'Point', coordinates:[g.lon, g.lat] },
        properties: g
      }))};
      map.getSource('predict').setData(fc);
      map.setLayoutProperty('predict-fill','visibility','visible');
      toast('Predicted risk grid shown (' + state.predict.length + ' cells)');
    } else {
      map.setLayoutProperty('predict-fill','visibility','none');
    }
  };
  document.getElementById('lEmerging').onchange = e =>
    map.setLayoutProperty('emerging-ring','visibility', e.target.checked ? 'visible':'none');
  document.getElementById('lPatrol').onchange = e => {
    const v = e.target.checked ? 'visible':'none';
    map.setLayoutProperty('patrol-lines','visibility', v);
    map.setLayoutProperty('patrol-stops','visibility', v);
  };
  document.getElementById('lUser').onchange = e => {
    if (e.target.checked){
      if (userLoc){
        if (userMarker) userMarker.remove();
        userMarker = new maplibregl.Marker({ color: '#26c281' })
          .setLngLat([userLoc.lon, userLoc.lat]).addTo(map);
        flyTo(userLoc.lat, userLoc.lon, 16);
      } else {
        useMyLocation();
        setTimeout(() => {
          if (userLoc){
            userMarker = new maplibregl.Marker({ color: '#26c281' })
              .setLngLat([userLoc.lon, userLoc.lat]).addTo(map);
            flyTo(userLoc.lat, userLoc.lon, 16);
          }
        }, 1500);
      }
    } else if (userMarker){
      userMarker.remove(); userMarker = null;
    }
  };
  document.getElementById('lBeams').onchange = e =>
    map.setLayoutProperty('beams-line','visibility', e.target.checked ? 'visible':'none');
  document.getElementById('lTowers').onchange = e => {
    const v = e.target.checked ? 'visible':'none';
    if (map.getLayer('risk-towers')) map.setLayoutProperty('risk-towers','visibility', v);
  };
  document.getElementById('lCams').onchange = e => {
    const v = e.target.checked ? 'visible':'none';
    if (map.getLayer('cameras-halo')) map.setLayoutProperty('cameras-halo','visibility', v);
    if (map.getLayer('cameras-dot'))  map.setLayoutProperty('cameras-dot','visibility', v);
  };
  document.getElementById('lFov').onchange = e => {
    const v = e.target.checked ? 'visible':'none';
    if (map.getLayer('cam-fov-fill')) map.setLayoutProperty('cam-fov-fill','visibility', v);
    if (map.getLayer('cam-fov-line')) map.setLayoutProperty('cam-fov-line','visibility', v);
    CINE.fov = e.target.checked;
    document.getElementById('btnCamFov').classList.toggle('on', CINE.fov);
  };
  document.getElementById('lDet').onchange = e => {
    const v = e.target.checked ? 'visible':'none';
    ['det-rings','det-core','det-core-glow','det-towers'].forEach(l => {
      if (map.getLayer(l)) map.setLayoutProperty(l,'visibility', v);
    });
  };

  /* detection engine controls */
  document.getElementById('detRun').onchange = e => {
    DETECT.running = e.target.checked;
    document.getElementById('engineStatus').textContent = DETECT.running ? 'RUNNING' : 'PAUSED';
    toast(DETECT.running ? 'AI detection engine started' : 'AI detection engine paused',
      DETECT.running ? '' : 'warn');
  };
  document.getElementById('detAutoFly').onchange = e => DETECT.autoFly = e.target.checked;
  document.getElementById('detAudio').onchange = e => {
    DETECT.audio = e.target.checked;
    if (DETECT.audio) unlockAudio();
  };
  document.getElementById('detAutoDispatch').onchange = e => DETECT.autoDispatch = e.target.checked;

  const sens = document.getElementById('detSens');
  const sensVal = document.getElementById('sensVal');
  sens.oninput = e => {
    DETECT.sensitivity = e.target.value / 100;
    sensVal.textContent = DETECT.sensitivity < 0.33 ? 'LOW'
                       : DETECT.sensitivity < 0.67 ? 'MEDIUM' : 'HIGH';
    scheduleNextDetection(performance.now());
  };

  /* optional layers hidden initially */
  map.setLayoutProperty('predict-fill','visibility','none');
  map.setLayoutProperty('emerging-ring','visibility','none');
  map.setLayoutProperty('patrol-lines','visibility','none');
  map.setLayoutProperty('patrol-stops','visibility','none');

  /* populate filters */
  const cSel = document.getElementById('fCrime');
  Object.keys(CRIME_WEIGHTS).forEach(c => {
    const o = document.createElement('option');
    o.value = c; o.textContent = c;
    cSel.appendChild(o);
  });
  const stSel = document.getElementById('fStation');
  STATIONS.forEach(s => {
    const o = document.createElement('option');
    o.value = s[0]; o.textContent = s[0];
    stSel.appendChild(o);
  });

  document.querySelectorAll('nav.tabs button').forEach(b => {
    b.onclick = () => switchTab(b.dataset.tab);
  });

  document.getElementById('bellBtn').onclick = e => {
    e.stopPropagation();
    document.getElementById('notifDrawer').classList.toggle('show');
  };
  document.addEventListener('click', e => {
    const drawer = document.getElementById('notifDrawer');
    if (!drawer.contains(e.target) && e.target.id !== 'bellBtn'){
      drawer.classList.remove('show');
    }
  });

  document.getElementById('searchBox').addEventListener('input', e => {
    const q = e.target.value.trim().toLowerCase();
    if (q.length < 2) return;
    const match = STATIONS.find(s => s[0].toLowerCase().includes(q));
    if (match){ flyTo(match[1], match[2], 15); }
    const hot = HOTSPOTS.find(h => h.n.toLowerCase().includes(q));
    if (hot){ flyTo(hot.lat, hot.lon, 16); }
    const cam = CAMERAS.find(c =>
      c.id.toLowerCase().includes(q) || c.name.toLowerCase().includes(q));
    if (cam){ flyTo(cam.lat, cam.lon, 17); openCCTV(cam.id); }
  });

  /* keyboard shortcuts */
  document.addEventListener('keydown', e => {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    const k = e.key;
    if (k === '1') switchTab('command');
    else if (k === '2') switchTab('livewatch');
    else if (k === '3') switchTab('analytics');
    else if (k === '4') switchTab('patrol');
    else if (k === '5') switchTab('reports');
    else if (k === 'r' || k === 'R'){ switchTab('reports');
      setTimeout(()=>document.getElementById('rDesc').focus(), 200); }
    else if (k === 'p' || k === 'P'){ switchTab('patrol'); runPatrol(); }
    else if (k === 'c' || k === 'C'){ clearPatrol(); }
    else if (k === 'v' || k === 'V'){ switchTab('livewatch'); openCCTVWall(); }
    else if (k === 'd' || k === 'D'){ forceDetection(); }
    else if (k === 'Escape'){
      document.getElementById('notifDrawer').classList.remove('show');
      closeCCTV();
      document.getElementById('alertBanner').classList.remove('show');
    }
  });

  setInterval(updateClock, 1000);
  updateClock();
}

function updateClock(){
  const d = new Date();
  document.getElementById('clockDate').textContent =
    d.toLocaleDateString('en-IN', { weekday:'short', day:'2-digit', month:'short' });
  document.getElementById('clockTime').textContent =
    d.toLocaleTimeString('en-IN', { hour12:false }) + ' IST';
}

/* ================= 3D CAMERA BUTTONS (no cinema) ================= */
function wireCinematicUI(){
  document.getElementById('btnOrbit').onclick = e => {
    CINE.orbit = !CINE.orbit;
    CINE.lastInteract = CINE.orbit ? 0 : performance.now();
    e.currentTarget.classList.toggle('on', CINE.orbit);
    toast(CINE.orbit ? '🛰 Auto-orbit engaged' : '🛰 Auto-orbit disengaged');
  };

  document.getElementById('btn3D').onclick = e => {
    CINE.buildings3d = !CINE.buildings3d;
    const v = CINE.buildings3d ? 'visible' : 'none';
    ['3d-buildings','3d-landmarks','risk-towers'].forEach(l => {
      if (map.getLayer(l)) map.setLayoutProperty(l,'visibility', v);
    });
    e.currentTarget.classList.toggle('on', CINE.buildings3d);
    toast(CINE.buildings3d ? '🏙 3D city model ONLINE' : '🏙 3D city model OFFLINE');
  };

  document.getElementById('btnTilt').onclick = e => {
    CINE.tilted = !CINE.tilted;
    map.easeTo({ pitch: CINE.tilted ? 68 : 0, duration:1200, essential:true });
    e.currentTarget.classList.toggle('on', CINE.tilted);
    setHudMode(CINE.tilted ? '3D PERSPECTIVE' : 'PLAN VIEW');
  };

  document.getElementById('btnRadar').onclick = e => {
    CINE.radar = !CINE.radar;
    if (map.getLayer('sweep-fill'))
      map.setLayoutProperty('sweep-fill','visibility', CINE.radar ? 'visible' : 'none');
    e.currentTarget.classList.toggle('on', CINE.radar);
    toast(CINE.radar ? '📡 Radar sweep active' : '📡 Radar sweep offline');
  };

  const fovBtn = document.getElementById('btnCamFov');
  fovBtn.classList.add('on');
  fovBtn.onclick = e => {
    CINE.fov = !CINE.fov;
    const v = CINE.fov ? 'visible' : 'none';
    if (map.getLayer('cam-fov-fill')) map.setLayoutProperty('cam-fov-fill','visibility', v);
    if (map.getLayer('cam-fov-line')) map.setLayoutProperty('cam-fov-line','visibility', v);
    document.getElementById('lFov').checked = CINE.fov;
    e.currentTarget.classList.toggle('on', CINE.fov);
    toast(CINE.fov ? '🎥 Camera FOV cones visible' : '🎥 Camera FOV cones hidden');
  };

  map.on('move', () => {
    const c = map.getCenter();
    const el = document.getElementById('hudCoord');
    if (el){
      el.textContent =
        'LAT ' + c.lat.toFixed(4) +
        ' · LON ' + c.lng.toFixed(4) +
        ' · Z ' + map.getZoom().toFixed(1) +
        ' · BRG ' + Math.round(map.getBearing()) + '°' +
        ' · PITCH ' + Math.round(map.getPitch()) + '°';
    }
  });

  ['mousedown','touchstart','wheel','dragstart','zoomstart','rotatestart','pitchstart']
    .forEach(ev => map.on(ev, () => { CINE.lastInteract = performance.now(); }));
}

/* ================= TOAST / LOADER ================= */
function toast(msg, kind=''){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className = 'show' + (kind ? ' ' + kind : '');
  clearTimeout(toast._t);
  toast._t = setTimeout(() => t.classList.remove('show'), 2800);
}
function progress(p, txt){
  document.getElementById('lProg').style.width = p + '%';
  if (txt) document.getElementById('lText').textContent = txt;
}
function hideLoader(){
  progress(100, 'Ready');
  setTimeout(() => document.getElementById('loader').classList.add('hide'), 350);
}

/* ================= BOOT ================= */
function boot(){
  progress(10, 'Initialising CRIMEMAP…');
  setTimeout(() => {
    progress(30, 'Loading incident database…');
    INCIDENTS = generateIncidents(4200);
    addNotification('Loaded ' + INCIDENTS.length + ' incident records', 'green');
  }, 40);
  setTimeout(() => progress(52, 'Linking CCTV network…'), 250);
  setTimeout(() => {
    progress(72, 'Loading 3D city model…');
    initMap();
  }, 500);
  setTimeout(() => progress(90, 'Starting AI detection engine…'), 800);
}
boot();

/* ================= EXPORTS ================= */
window.flyTo = flyTo;
window.runPatrol = runPatrol;
window.clearPatrol = clearPatrol;
window.zoomToRoute = zoomToRoute;
