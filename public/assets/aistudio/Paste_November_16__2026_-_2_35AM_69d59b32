/* ---- geometry ---- */
function arcCoords(a, b, steps=54, curve=0.16){
  const out = [];
  const mx = (a[0]+b[0])/2, my = (a[1]+b[1])/2;
  const dx = b[0]-a[0], dy = b[1]-a[1];
  const cx = mx - dy*curve, cy = my + dx*curve;
  for (let i=0;i<=steps;i++){
    const t = i/steps, u = 1-t;
    out.push([
      u*u*a[0] + 2*u*t*cx + t*t*b[0],
      u*u*a[1] + 2*u*t*cy + t*t*b[1]
    ]);
  }
  return out;
}

/* hexagon prism footprint (metres) */
function hexPoly(lon, lat, radiusM, rot=0){
  const R = 6371000, pts = [];
  for (let i=0;i<=6;i++){
    const a = rot + i*Math.PI/3;
    const dx = Math.cos(a)*radiusM, dy = Math.sin(a)*radiusM;
    const dLat = dy/R*180/Math.PI;
    const dLon = dx/(R*Math.cos(lat*Math.PI/180))*180/Math.PI;
    pts.push([lon+dLon, lat+dLat]);
  }
  return [pts];
}

/* CCTV field-of-view sector polygon */
function sectorPoly(lon, lat, bearing, fov, rangeM, steps=18){
  const R = 6371000, pts = [[lon, lat]];
  const start = bearing - fov/2;
  for (let i=0;i<=steps;i++){
    const a = (start + fov*i/steps) * Math.PI/180;
    const dx = Math.sin(a)*rangeM, dy = Math.cos(a)*rangeM;
    const dLat = dy/R*180/Math.PI;
    const dLon = dx/(R*Math.cos(lat*Math.PI/180))*180/Math.PI;
    pts.push([lon+dLon, lat+dLat]);
  }
  pts.push([lon, lat]);
  return [pts];
}

/* ---- animated sources ---- */
function towerFC(t){
  return { type:'FeatureCollection', features: state.hotspots.slice(0,14).map((h,i)=>{
    const pulse = 0.86 + 0.14*Math.sin(t*1.6 + i*0.8);
    const base  = 45 + h.risk*3.4;      // 45 m → 385 m
    return {
      type:'Feature',
      geometry:{ type:'Polygon', coordinates: hexPoly(h.lon, h.lat, 52 + h.risk*0.35, i*0.4) },
      properties:{ height: base*pulse, color: riskColor(h.risk) }
    };
  })};
}

function pulseFC(t){
  const feats = [];
  state.hotspots.slice(0,8).forEach((h,i)=>{
    for (let k=0;k<3;k++){
      const phase = ((t*0.42) + k/3 + i*0.11) % 1;
      feats.push({
        type:'Feature',
        geometry:{ type:'Point', coordinates:[h.lon, h.lat] },
        properties:{ r: 5 + phase*42, o: (1-phase)*0.62, color: riskColor(h.risk) }
      });
    }
  });
  return { type:'FeatureCollection', features: feats };
}

function beamsFC(){
  const feats = [];
  state.hotspots.slice(0,6).forEach((h,i)=>{
    const st = STATIONS[i % STATIONS.length];
    feats.push({
      type:'Feature',
      geometry:{ type:'LineString', coordinates: arcCoords([st[2], st[1]], [h.lon, h.lat]) },
      properties:{ color: riskColor(h.risk) }
    });
  });
  return { type:'FeatureCollection', features: feats };
}

function sweepFC(t){
  const c = map.getCenter();
  const R = 0.030, spread = 0.40;
  const a0 = (t*0.75) % (Math.PI*2);
  const ring = [[c.lng, c.lat]];
  for (let i=0;i<=16;i++){
    const a = a0 + spread*(i/16);
    ring.push([ c.lng + Math.cos(a)*R, c.lat + Math.sin(a)*R*0.72 ]);
  }
  ring.push([c.lng, c.lat]);
  return { type:'FeatureCollection', features:[{
    type:'Feature', geometry:{ type:'Polygon', coordinates:[ring] }, properties:{}
  }]};
}

/* camera FOV source */
function camFovFC(){
  return { type:'FeatureCollection', features: CAMERAS.map(c => ({
    type:'Feature',
    geometry:{ type:'Polygon', coordinates: sectorPoly(c.lon, c.lat, c.bearing, c.fov, c.range) },
    properties:{ id:c.id, status:c.status, type:c.type }
  }))};
}

function camPointFC(){
  return { type:'FeatureCollection', features: CAMERAS.map(c => ({
    type:'Feature',
    geometry:{ type:'Point', coordinates:[c.lon, c.lat] },
    properties:{ id:c.id, name:c.name, status:c.status, type:c.type }
  }))};
}

/* ---- live detections sources ---- */
function detTowerFC(t){
  const now = Date.now();
  return { type:'FeatureCollection', features: liveDetections
    .filter(d => d.status !== 'resolved')
    .map(d => {
      const age = (now - d.bornAt)/1000;
      const grow = Math.min(1, age/0.45);
      const h = (70 + d.severity*22) * grow * (0.92 + 0.08*Math.sin(t*5 + d.seed));
      return {
        type:'Feature',
        geometry:{ type:'Polygon', coordinates: hexPoly(d.lon, d.lat, 34, d.seed) },
        properties:{
          height: h,
          color: d.color,
          opacity: d.status === 'dispatched' ? 0.58 : 0.86
        }
      };
    })};
}

function detRingFC(t){
  const now = Date.now();
  const feats = [];
  liveDetections.filter(d => d.status !== 'resolved').forEach(d => {
    const age = (now - d.bornAt)/1000;
    for (let k=0;k<4;k++){
      const phase = ((t*0.85) + k/4 + d.seed) % 1;
      feats.push({
        type:'Feature',
        geometry:{ type:'Point', coordinates:[d.lon, d.lat] },
        properties:{
          r: 6 + phase*58,
          o: Math.max(0, (1-phase) * (age < 0.4 ? age/0.4 : 1) * 0.85),
          color: d.color
        }
      });
    }
  });
  return { type:'FeatureCollection', features: feats };
}

function detCoreFC(t){
  const now = Date.now();
  return { type:'FeatureCollection', features: liveDetections
    .filter(d => d.status !== 'resolved')
    .map(d => {
      const age = (now - d.bornAt)/1000;
      return {
        type:'Feature',
        geometry:{ type:'Point', coordinates:[d.lon, d.lat] },
        properties:{ color: d.color, o: 0.85, r: 9 + 3*Math.sin(t*6 + d.seed) }
      };
    })};
}

