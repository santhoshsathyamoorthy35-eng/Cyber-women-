window.clearNotifs = clearNotifs;
window.flyToStation = flyToStation;
window.openCCTV = openCCTV;
window.openCCTVWall = openCCTVWall;
window.closeCCTV = closeCCTV;
window.dispatchFromCCTV = dispatchFromCCTV;
window.ackFromCCTV = ackFromCCTV;
window.dispatchToDetection = dispatchToDetection;
window.acknowledgeDetection = acknowledgeDetection;
window.resolveDetection = resolveDetection;
window.focusDetection = focusDetection;
window.forceDetection = forceDetection;
window.clearResolved = clearResolved;
</script>
