function flyTo(lat, lon, zoom=15){
  const wrap = document.getElementById('mapWrap');
  showReticle(true, 'TARGET LOCK');
  wrap.classList.add('cinema');

  map.flyTo({
    center: [lon, lat],
    zoom,
    pitch: 68,
    bearing: map.getBearing() + 24,
    duration: 2000,
    curve: 1.42,
    essential: true,
    easing: t => 1 - Math.pow(1 - t, 3)
  });

  clearTimeout(flyTo._t);
  flyTo._t = setTimeout(() => {
    showReticle(false);
    wrap.classList.remove('cinema');
  }, 2250);
}

function flyToStation(name){
  const s = STATIONS.find(x => x[0] === name);
