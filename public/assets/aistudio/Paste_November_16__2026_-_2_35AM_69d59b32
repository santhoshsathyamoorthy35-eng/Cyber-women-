function updateAnalytics(filt){
  const days = +document.getElementById('fDays').value;
  const now = Date.now();
  const prevPeriod = INCIDENTS.filter(p =>
    p.ts < now - days*86400000 && p.ts >= now - 2*days*86400000);
  const incEl = document.getElementById('kInc');
  if (incEl) incEl.textContent = fmt(filt.length);
  const deltaEl = document.getElementById('kIncD');
  if (deltaEl){
    const change = prevPeriod.length ? Math.round((filt.length - prevPeriod.length)/prevPeriod.length * 100) : 0;
    deltaEl.textContent = (change >= 0 ? '+' : '') + change + '% vs previous period';
    deltaEl.className = 'delta' + (change < 0 ? '' : ' down');
  }
  const hotEl = document.getElementById('kHot');
  if (hotEl) hotEl.textContent = state.hotspots.length;

  const hours = new Array(24).fill(0);
  const crimes = {};
  for (const p of filt){
    hours[new Date(p.ts).getHours()]++;
    crimes[p.crime] = (crimes[p.crime]||0)+1;
  }
  let peakH = 0;
  for (let i=1;i<24;i++) if (hours[i] > hours[peakH]) peakH = i;
  const peakEl = document.getElementById('kPeak');
  if (peakEl) peakEl.textContent = pad(peakH,2) + ':00';
  const topEl = document.getElementById('kTop');
  if (topEl && Object.keys(crimes).length){
    topEl.textContent = Object.entries(crimes).sort((a,b)=>b[1]-a[1])[0][0];
  }

  const donutEl = document.getElementById('chartDonut');
  if (donutEl){
    const entries = Object.entries(crimes).sort((a,b)=>b[1]-a[1]).slice(0,8);
    donutEl.innerHTML = renderDonut(entries.map(([k,v])=>({
      label:k, value:v, color: CRIME_COLORS[k] || '#8ea0c4'
    })), 220);
  }

  const stTable = document.getElementById('stationTable');
  if (stTable){
    const st = {};
    for (const p of filt){
      st[p.station] = st[p.station] || { count: 0, sev: 0, top: {} };
      st[p.station].count++;
      st[p.station].sev += p.sev;
      st[p.station].top[p.crime] = (st[p.station].top[p.crime]||0)+1;
    }
    const rows = Object.entries(st).sort((a,b)=>b[1].count - a[1].count);
    stTable.innerHTML = `<table class="tbl">
      <thead><tr><th>Station</th><th>Cases</th><th>Avg Sev</th><th>Top Crime</th></tr></thead>
      <tbody>${rows.map(([name,d])=>{
        const top = Object.entries(d.top).sort((a,b)=>b[1]-a[1])[0][0];
        return `<tr onclick="flyToStation('${name}')">
          <td>${name.replace(' PS','')}</td>
          <td>${d.count}</td>
          <td>${(d.sev/d.count).toFixed(1)}</td>
          <td>${top}</td>
        </tr>`;
      }).join('')}</tbody>
    </table>`;
  }
}

function renderDonut(data, size=200){
  const total = data.reduce((a,b)=>a+b.value,0) || 1;
  const r = size/2 - 22;
  const cx = size/2, cy = size/2;
  let angle = -Math.PI/2;
  let arcs = '', legend = '';
  for (const d of data){
    const sweep = d.value/total * Math.PI * 2;
    const x1 = cx + r * Math.cos(angle);
    const y1 = cy + r * Math.sin(angle);
    const x2 = cx + r * Math.cos(angle + sweep);
    const y2 = cy + r * Math.sin(angle + sweep);
    const large = sweep > Math.PI ? 1 : 0;
    if (sweep > 0.005){
      arcs += `<path d="M ${x1} ${y1} A ${r} ${r} 0 ${large} 1 ${x2} ${y2}"
                      stroke="${d.color}" stroke-width="26" fill="none" stroke-linecap="butt"/>`;
    }
    const p = Math.round(d.value/total*100);
    legend += `<div class="legend" style="justify-content:space-between">
      <span style="display:flex;align-items:center;gap:8px">
        <span class="sw" style="background:${d.color}"></span>${d.label}
      </span>
      <b style="color:var(--fg)">${d.value} <span style="color:var(--muted)">(${p}%)</span></b>
    </div>`;
    angle += sweep;
  }
  return `<div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
    <svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">
      <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="#0a1424" stroke-width="26"/>
      ${arcs}
      <text x="${cx}" y="${cy-4}" text-anchor="middle" font-size="22" font-weight="800"
            fill="#eaf0fb" font-family="Inter,sans-serif">${fmt(total)}</text>
      <text x="${cx}" y="${cy+16}" text-anchor="middle" font-size="10"
            fill="#7e91b8" font-family="Inter,sans-serif" letter-spacing="1">INCIDENTS</text>
    </svg>
    <div style="flex:1;min-width:160px;font-size:11px">${legend}</div>
  </div>`;
}

