/* ================= ANALYTICS ================= */
function detectHotspots(list, minCell=6, minCluster=8){
  if (!list || list.length < 20) return [];
  const cellMap = new Map();
  const k = (i,j)=> i+"|"+j;
  for (const p of list){
    const i = Math.floor((p.lat - BOUNDS.latMin)/GRID_STEP);
    const j = Math.floor((p.lon - BOUNDS.lonMin)/GRID_STEP);
    const key = k(i,j);
    if (!cellMap.has(key)) cellMap.set(key, { i, j, pts:[] });
    cellMap.get(key).pts.push(p);
  }
  const cells = [...cellMap.values()].filter(c => c.pts.length >= minCell);
  if (!cells.length) return [];

  const cellIndex = new Map();
  for (const c of cells) cellIndex.set(k(c.i,c.j), c);

  const visited = new Set();
  const clusters = [];
  for (const start of cells){
    const sk = k(start.i,start.j);
    if (visited.has(sk)) continue;
    const queue = [start]; visited.add(sk);
    const members = [];
    while (queue.length){
      const cur = queue.shift();
      members.push(cur);
      for (let di=-1; di<=1; di++) for (let dj=-1; dj<=1; dj++){
        const nk = k(cur.i+di, cur.j+dj);
        if (visited.has(nk)) continue;
        const n = cellIndex.get(nk);
        if (n){ visited.add(nk); queue.push(n); }
      }
    }
    const allPts = members.flatMap(m=>m.pts);
    if (allPts.length < minCluster) continue;

    const latC = allPts.reduce((a,p)=>a+p.lat,0)/allPts.length;
    const lonC = allPts.reduce((a,p)=>a+p.lon,0)/allPts.length;
    const hours = {}, dow = {}, ctypes = {};
    let sevSum = 0;
    for (const p of allPts){
      const h = new Date(p.ts).getHours();
      const d = new Date(p.ts).toLocaleDateString('en-US',{weekday:'long'});
      hours[h] = (hours[h]||0)+1;
      dow[d] = (dow[d]||0)+1;
      ctypes[p.crime] = (ctypes[p.crime]||0)+1;
      sevSum += p.sev;
    }
    const peakHour = +Object.entries(hours).sort((a,b)=>b[1]-a[1])[0][0];
    const peakDay  = Object.entries(dow).sort((a,b)=>b[1]-a[1])[0][0];
    const topCrime = Object.entries(ctypes).sort((a,b)=>b[1]-a[1])[0][0];
    const avgSev = sevSum/allPts.length;
    const risk = Math.min(100, Math.round(allPts.length*1.5 + avgSev*7 + recentBoost(allPts)));

    clusters.push({
      lat: latC, lon: lonC, count: allPts.length,
      peakHour, peakDay, topCrime,
      avgSev: +avgSev.toFixed(2), risk,
      crimes: Object.fromEntries(Object.entries(ctypes).sort((a,b)=>b[1]-a[1]).slice(0,5))
    });
  }
  clusters.sort((a,b)=>b.risk - a.risk);
  return clusters;
}
function recentBoost(pts){
  const now = Date.now();
  const recent = pts.filter(p => now - p.ts < 14*86400000).length;
  return Math.min(20, recent * 1.2);
}

function emergingHotspots(){
  const now = Date.now();
  const recent = INCIDENTS.filter(p => p.ts >= now - 7*86400000);
  const base   = INCIDENTS.filter(p => p.ts >= now - 35*86400000 && p.ts < now - 7*86400000);
  const k = (lat,lon)=> Math.round(lat/GRID_STEP)+"|"+Math.round(lon/GRID_STEP);
  const rC = new Map(), bC = new Map();
  recent.forEach(p => { const key = k(p.lat,p.lon); rC.set(key,(rC.get(key)||0)+1); });
  base.forEach(p => { const key = k(p.lat,p.lon); bC.set(key,(bC.get(key)||0)+1); });
  const out = [];
  for (const [key,c] of rC){
    if (c < 3) continue;
    const b = (bC.get(key)||0)/4;
    const growth = (c - b) / Math.max(b, 1);
    if (growth >= 0.5){
      const [i,j] = key.split("|").map(Number);
      out.push({
        lat: i*GRID_STEP, lon: j*GRID_STEP,
        recent: c, base: +b.toFixed(1),
        growth: Math.round(growth*100)
      });
    }
  }
  out.sort((a,b)=>b.growth - a.growth);
  return out.slice(0, 20);
}

function predictRiskGrid(){
  const now = Date.now();
  const cellMap = new Map();
  const k = (lat,lon)=> Math.round(lat/GRID_STEP)+"|"+Math.round(lon/GRID_STEP);
  for (const p of INCIDENTS){
    const key = k(p.lat,p.lon);
    if (!cellMap.has(key)) cellMap.set(key, { pts:[] });
    cellMap.get(key).pts.push(p);
  }
  const out = [];
  for (const [key, c] of cellMap){
    const pts = c.pts;
    if (pts.length < 3) continue;
    let recentW = 0, olderW = 0, sevSum = 0;
    for (const p of pts){
      const ageDays = (now - p.ts)/86400000;
      const w = Math.exp(-ageDays/90);
      if (ageDays <= 14) recentW += w;
      else olderW += w;
      sevSum += p.sev * w;
    }
    const trend = (recentW + 0.001) / (olderW/6 + 0.001);
    const base = pts.length * 1.1;
    const score = Math.min(100, Math.round(
      base + Math.min(trend,3)*14 + recentW*3 + (sevSum/Math.max(pts.length,1))*2
    ));
    if (score < 8) continue;
    const [i,j] = key.split("|").map(Number);
    out.push({
      lat: i*GRID_STEP, lon: j*GRID_STEP,
      risk: score, n: pts.length,
      reason: `${pts.length} historical · trend ×${trend.toFixed(2)}`
    });
  }
  out.sort((a,b)=>b.risk - a.risk);
  return out.slice(0, 350);
}

function optimizePatrols(nUnits, horizonMin, priority){
  const grid = predictRiskGrid().slice(0, 50);
  const units = STATIONS.slice(0, Math.min(nUnits, STATIONS.length)).map((s,i)=>({
    name: "PCR-"+pad(i+1,2),
    station: s[0], lat: s[1], lon: s[2]
  }));
  const visited = new Set();
  const routes = [];
  for (const u of units){
    let cur = { lat: u.lat, lon: u.lon };
    let tLeft = horizonMin;
    const path = [{ lat: u.lat, lon: u.lon, risk: 0, stop: 0, name: u.station }];
    while (tLeft > 8){
      let bestIdx = -1, bestScore = Infinity;
      for (let j=0;j<grid.length;j++){
        if (visited.has(j)) continue;
        const g = grid[j];
        const d = haversineKm(cur.lat, cur.lon, g.lat, g.lon);
        let score = d / Math.max(g.risk, 1);
        if (priority === 'severity') score = d / Math.max(g.n, 1);
        if (score < bestScore){ bestScore = score; bestIdx = j; }
      }
      if (bestIdx < 0) break;
      const g = grid[bestIdx];
      const d = haversineKm(cur.lat, cur.lon, g.lat, g.lon);
      const tMin = (d/25)*60;
      if (tMin > tLeft) break;
      visited.add(bestIdx);
      tLeft -= tMin;
      path.push({ lat: g.lat, lon: g.lon, risk: g.risk, stop: path.length });
      cur = { lat: g.lat, lon: g.lon };
    }
    routes.push({
      unit: u.name, station: u.station,
      stops: path.length - 1,
      timeUsed: Math.round(horizonMin - tLeft),
      path
    });
  }
  return routes;
}

