/* ---- animation loop ---- */
function startCineLoop(){
  let last = performance.now();
  let dashAcc = 0, pulseAcc = 0, detAcc = 0;

  function frame(now){
    const dt = Math.min(60, now - last);
    last = now;

    /* idle auto-orbit */
    if (CINE.orbit && !map.isMoving() && now - CINE.lastInteract > 7000){
      map.setBearing((map.getBearing() + dt * 0.0016) % 360);
    }

    /* energy-flow dashes */
    dashAcc += dt;
    if (dashAcc > 110){
      dashAcc = 0;
      CINE.dashIndex = (CINE.dashIndex + 1) % DASH_SEQ.length;
      try{
        if (map.getLayer('patrol-lines'))
          map.setPaintProperty('patrol-lines','line-dasharray', DASH_SEQ[CINE.dashIndex]);
        if (map.getLayer('beams-line'))
          map.setPaintProperty('beams-line','line-dasharray',
            DASH_SEQ[(CINE.dashIndex + 5) % DASH_SEQ.length]);
      }catch(e){}
    }

    /* 18 fps — radar pulses, towers, detections */
    pulseAcc += dt;
    if (pulseAcc > 55){
      pulseAcc = 0;
      const t = now / 1000;
      try{
        if (map.getSource('pulse'))       map.getSource('pulse').setData(pulseFC(t));
        if (map.getSource('risk-towers') && CINE.buildings3d)
          map.getSource('risk-towers').setData(towerFC(t));
        if (map.getSource('sweep') && CINE.radar)
          map.getSource('sweep').setData(sweepFC(t));
      }catch(e){}
    }

    /* detections need a faster refresh for the "shoot up" animation */
    detAcc += dt;
    if (detAcc > 33){
      detAcc = 0;
      const t = now / 1000;
      try{
        if (map.getSource('det-rings'))  map.getSource('det-rings').setData(detRingFC(t));
        if (map.getSource('det-core'))   map.getSource('det-core').setData(detCoreFC(t));
        if (map.getSource('det-towers')) map.getSource('det-towers').setData(detTowerFC(t));
      }catch(e){}
    }

    /* detection engine tick */
    tickDetectionEngine(now);

    /* cctv wall render */
    tickCCTVWall(now);

    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
}

